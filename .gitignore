# ──────────────────────────────────────────────────────────────────────────────
#  Restaurant Manager — root .gitignore
#  Excludes build artifacts, dependencies, secrets, and OS junk from version
#  control. If you're tempted to add a file by force, ask: would this leak a
#  secret, or could the next dev regenerate it from a fresh `npm install`?
# ──────────────────────────────────────────────────────────────────────────────

# ── Dependencies (regenerated by npm install) ─────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/
.npm/

# ── Build outputs (regenerated by `npm run build`) ────────────────────────
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
# Next.js standalone output (server.js + generated package.json). A stray build
# once wrote these into a doubly-nested "apps/Restaurant Manager/" path — ignore
# any such accidental nesting so it can never be committed again.
apps/Restaurant Manager/
**/standalone/

# ── Capacitor / Android build artifacts ───────────────────────────────────
apps/android-rider/android/app/build/
apps/android-rider/android/build/
apps/android-rider/android/.gradle/
apps/android-rider/android/local.properties
apps/android-rider/android/captures/
apps/android-rider/android/.idea/

# ── Build artefacts (mobile) — large binary outputs, never commit ─────────
*.apk
*.aab
*.ipa
apps/rider-native/build-*.apk
apps/rider-native/build-*.aab

# Stray app.json sometimes left at repo root by eas-cli when run from the
# wrong directory. The legitimate app.json lives at apps/rider-native/.
/app.json

# ── SECRETS — never commit ────────────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example
!.env.demo.example
!**/.env.demo.example
!deploy/.env.production.example
.env.tmp
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/

# ── Capacitor / Android signing — NEVER commit ────────────────────────────
apps/android-rider/.env
apps/android-rider/android/keystore.properties
apps/android-rider/android/app/*.keystore
apps/android-rider/android/app/*.jks
*.keystore
*.jks

# ── Local databases & uploads ─────────────────────────────────────────────
prisma/dev.db
prisma/dev.db-journal
prisma/*.sqlite
public/uploads/
apps/web/public/uploads/
/var/www/restaurant-manager/uploads/

# ── Test outputs ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
*.lcov

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ── Editors / IDEs ────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.history/

# ── OS junk ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Local dev caches ──────────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.swc/

# ── Prisma generated client (regenerated by `prisma generate`) ────────────
# Keep schema.prisma + migrations; ignore the runtime client.
apps/web/node_modules/.prisma/

# ── Local backup snapshots from auto-backup script ────────────────────────
.git-auto-backup.log

# ── Local-only deploy files (filled in per-environment) ───────────────────
deploy/.env.production
deploy/keystore.properties
deploy/*.keystore

# ── APK output directory from build-apk.sh ────────────────────────────────
/out/

# ── Misc tooling ──────────────────────────────────────────────────────────
.vercel
.netlify
.serverless/
.firebase/

# ── Client billing / invoices (never commit — contains client PII) ────────
Invoice-*.pdf
/invoices/

# Scratch folder used when a mount forbids unlink; never commit it.
_to_delete/

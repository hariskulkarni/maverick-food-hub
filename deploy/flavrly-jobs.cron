# ─────────────────────────────────────────────────────────────────────────────
#  Flavrly — scheduled platform jobs
#
#  Every job below authenticates with INTERNAL_CRON_SECRET from
#  /opt/restaurant-manager/apps/web/.env. The secret is NOT written into this
#  file; each line sources the .env at run time so rotating the secret needs no
#  cron change.
#
#  INSTALL (on the VPS):
#      sudo /opt/restaurant-manager/deploy/phonepe-setup.sh cron
#    or manually:
#      sudo install -m 0644 /opt/restaurant-manager/deploy/flavrly-jobs.cron \
#                           /etc/cron.d/flavrly-jobs
#  cron picks up /etc/cron.d automatically — no restart needed.
#
#  VERIFY:   cat /etc/cron.d/flavrly-jobs && systemctl status cron --no-pager
#            tail -f /var/log/restaurant-manager/jobs.log
#  REMOVE:   sudo rm /etc/cron.d/flavrly-jobs
#
#  Times are server-local (IST on this VPS).
#  cron.d line format:  m h dom mon dow  USER  command
# ─────────────────────────────────────────────────────────────────────────────
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# PhonePe reconciliation — the safety net for lost webhooks. NOT optional in
# production: this is what closes out a payment whose callback never arrived.
# Re-reads anything left pending between 90s and 24h old.
*/5 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 60 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/phonepe-reconcile/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Rider shifts booked but never started → MISSED (route docs say every 15-30 min)
*/20 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 60 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/rider-shift-missed/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Rider KYC documents past their expiry → EXPIRED (route docs say daily ~02:00)
0 2 * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 120 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/kyc-expiry/run >> /var/log/restaurant-manager/jobs.log 2>&1

# FSSAI licences expiring within 30 days → notify restaurant admins
# (route docs say daily ~06:00; the sender debounces per branch ~every 3 days)
0 6 * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 120 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/food-license-expiry/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Google reviews — sync + auto-reply rules + negative alerts + insights + SLA escalation.
# Every 15 minutes (matches the route doc). Real-time Pub/Sub push is optional on top.
*/15 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 90 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/google-reviews/run >> /var/log/restaurant-manager/jobs.log 2>&1

# YouPI reconciliation — verifies in-flight YouPI payments (status + UTR + amount) and is the only path that captures them.
*/3 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 60 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/youpi-reconcile/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Flavrly PG worker — webhook inbox, transactional outbox (order release), reconcile sweep, each under a DB lease. Every minute.
* * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 55 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/pg-worker/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Google review asks — sends due post-order review requests + one optional reminder (idempotent).
*/5 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 60 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/review-requests/run >> /var/log/restaurant-manager/jobs.log 2>&1
# Google reviews weekly digest to restaurant owners — Mondays 09:00 IST.
0 9 * * 1 deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 300 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/review-digest/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Stale rider heartbeats → offline, so the allocator never assigns a rider whose
# app died (route docs: 1-minute cron).
* * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 50 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/rider-heartbeat/sweep >> /var/log/restaurant-manager/jobs.log 2>&1

# Stuck-order detector → live-ops escalations (route docs: 1-minute cron; the
# dashboard "Scan now" button stays as a manual trigger).
* * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 50 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/escalations/scan >> /var/log/restaurant-manager/jobs.log 2>&1

# ── Dispatch telemetry (feat/dispatch-telemetry) ──────────────────────────────
# JIT rider invitations — releases held orders into the normal dispatch flow. No-op while the JIT setting is OFF (default).
* * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 50 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/dispatch-jit/run >> /var/log/restaurant-manager/jobs.log 2>&1
# Stationary on-task riders → RIDER_STATIONARY escalation on /platform/live-ops (debounced per assignment).
*/2 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 90 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/rider-stationary/run >> /var/log/restaurant-manager/jobs.log 2>&1
# H3 zone supply/demand snapshot (also the rider-hours source for orders-per-rider-hour).
*/5 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 90 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/zone-snapshot/run >> /var/log/restaurant-manager/jobs.log 2>&1
# Nightly prep-time percentiles per restaurant × hour (feeds predicted prep / JIT).
10 3 * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 300 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/prep-stats/run >> /var/log/restaurant-manager/jobs.log 2>&1
# Observability Center — alert evaluation every minute (also refreshes stale probes
# and flushes metrics). Super-admin e-mail/SMS on new alerts, debounced.
* * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 50 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/obs-alerts/run >> /var/log/restaurant-manager/jobs.log 2>&1
# Observability retention — prune metrics (30d), errors (14d), job runs (90d); daily 03:30 IST.
30 3 * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 300 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/obs-retention/run >> /var/log/restaurant-manager/jobs.log 2>&1

# Novaryq POS worker — webhook inbox (POS status + 86'd items) and order push/cancel outbox, each under a DB lease. Every minute.
# No-op unless NOVARYQ_INTEGRATION_ENABLED=true in apps/web/.env.
* * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 55 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/novaryq-worker/run >> /var/log/restaurant-manager/jobs.log 2>&1
# Novaryq menu/availability reconcile — fallback for missed webhooks. Every 15 minutes.
*/15 * * * * deploy . /opt/restaurant-manager/apps/web/.env; curl -fsS -m 55 -X POST -H "x-internal-secret: $INTERNAL_CRON_SECRET" https://flavrly.in/api/platform/jobs/novaryq-reconcile/run >> /var/log/restaurant-manager/jobs.log 2>&1

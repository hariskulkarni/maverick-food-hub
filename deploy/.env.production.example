# ──────────────────────────────────────────────────────────────────────────────
# Restaurant Manager — production .env template
#
# Copy this file to /opt/restaurant-manager/apps/web/.env on the production VPS
# and fill in every uncommented line. Anything inside `# ...` blocks is optional
# and can be left commented unless you're activating that feature.
#
# After any change, reload:
#   pm2 reload rm-web rm-worker --update-env
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core (REQUIRED) ─────────────────────────────────────────────────────────
NODE_ENV="production"

# Postgres on the same host. Replace the password with what you set in
# `CREATE USER restaurant_manager WITH PASSWORD ...` during §4.1 of
# PRODUCTION-DEPLOY.md.
DATABASE_URL="postgresql://restaurant_manager:REPLACE_ME@127.0.0.1:5432/restaurant_manager?schema=public"

# Public URL — must match what's in Cloudflare. NO trailing slash.
NEXTAUTH_URL="https://yourdomain.in"

# Secrets — generate with:  openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_ME_32_BYTES_HEX"
APP_ENCRYPTION_KEY="REPLACE_ME_32_BYTES_HEX"

# Storage adapter. Local FS is fine for Phase 1. Bucket adapters wire up later.
STORAGE_PROVIDER="local"
UPLOADS_DIR="/var/www/restaurant-manager/uploads"

# Deployment mode flag — surfaces in /platform/system-health
DEPLOYMENT_MODE="LOW_COST_SINGLE_VPS"
LAST_BACKUP_MARKER="/var/lib/restaurant-manager/last-backup.txt"

# Cookie scope for cross-subdomain auth (uncomment once subdomain tenancy is on)
# COOKIE_DOMAIN=".yourdomain.in"

# ─── Razorpay (REQUIRED for payments) ────────────────────────────────────────
# Start in TEST mode. Flip to live keys after Razorpay KYC is approved.
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME"
RAZORPAY_WEBHOOK_SECRET="REPLACE_ME"

# ─── SMS — pick ONE provider ─────────────────────────────────────────────────
# MSG91 (recommended — DLT-compliant OTPs)
NOTIFIER_SMS="msg91"
MSG91_AUTH_KEY="REPLACE_ME"
MSG91_SENDER_ID="MVKFHB"
MSG91_ROUTE="4"
MSG91_DLT_TEMPLATE_ID="REPLACE_ME"

# Alternatives — pick one and comment out the MSG91 block above.
# NOTIFIER_SMS="fast2sms"
# FAST2SMS_API_KEY="REPLACE_ME"
#
# NOTIFIER_SMS="textlocal"
# TEXTLOCAL_API_KEY="REPLACE_ME"
# TEXTLOCAL_SENDER_ID="MVKFHB"

# ─── Email — pick ONE provider ───────────────────────────────────────────────
# Zoho Mail (recommended — Lite plan ₹90/user/month)
NOTIFIER_EMAIL="zoho_smtp"
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="587"
SMTP_USER="orders@yourdomain.in"
SMTP_PASS="REPLACE_ME_APP_PASSWORD"
SMTP_FROM="orders@yourdomain.in"
SMTP_SECURE="false"

# Brevo (free 300/day)
# NOTIFIER_EMAIL="brevo_smtp"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="REPLACE_ME@yourdomain.in"
# SMTP_PASS="REPLACE_ME_BREVO_KEY"
# SMTP_FROM="orders@yourdomain.in"
# SMTP_SECURE="false"

# ─── Google OAuth (optional — customer Google sign-in) ───────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.in/api/auth/callback/google
# GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="REPLACE_ME"

# ─── KYC verifier (rider onboarding) ─────────────────────────────────────────
# "mock" replays canned responses (dev). "surepass" hits live APIs (₹1–₹3 per
# Aadhaar/PAN/license check). "karza" is similar pricing, larger enterprise.
KYC_VERIFIER="mock"
# KYC_VERIFIER="surepass"
# SUREPASS_API_KEY="REPLACE_ME"
# SUREPASS_BASE_URL="https://kyc-api.surepass.io"

# ─── Maps (optional) ─────────────────────────────────────────────────────────
# We default to free OSM tiles via Leaflet. If you flip to Mapbox/Google later:
# MAPS_PROVIDER="mapbox"
# MAPBOX_TOKEN="REPLACE_ME"

# ─── Feature flags — Phase 1 defaults ────────────────────────────────────────
ENABLE_WALLET="false"
ENABLE_LOYALTY="false"
ENABLE_WHATSAPP="false"
ENABLE_S3_STORAGE="false"
ENABLE_SUBDOMAIN_TENANCY="false"

# ─── Observability (optional but recommended) ────────────────────────────────
# Sentry — free tier covers 5k errors/month
# SENTRY_DSN="https://REPLACE_ME@sentry.io/123456"
# SENTRY_ENVIRONMENT="production"

# PostHog — free tier covers 1M events/month
# POSTHOG_KEY="phc_REPLACE_ME"
# POSTHOG_HOST="https://app.posthog.com"

# ─── Backups (read by deploy/backup.sh) ──────────────────────────────────────
# Set in /etc/default/rm-backup, not here. Listed for reference.
# RCLONE_REMOTE="b2:maverick-rm-backups"
# BACKUP_RETENTION_DAYS_LOCAL="14"
# BACKUP_RETENTION_DAYS_REMOTE="30"

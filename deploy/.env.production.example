# ──────────────────────────────────────────────────────────────────────────────
# Restaurant Manager — production .env template
#
# Copy this file to /opt/restaurant-manager/apps/web/.env on the production VPS
# and fill in every uncommented line. Anything inside `# ...` blocks is optional
# and can be left commented unless you're activating that feature.
#
# After any change, reload:
#   pm2 reload rm-web rm-worker --update-env
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core (REQUIRED) ─────────────────────────────────────────────────────────
NODE_ENV="production"

# Postgres on the same host. Replace the password with what you set in
# `CREATE USER restaurant_manager WITH PASSWORD ...` during §4.1 of
# PRODUCTION-DEPLOY.md.
DATABASE_URL="postgresql://restaurant_manager:REPLACE_ME@127.0.0.1:5432/restaurant_manager?schema=public"

# Public URL — must match what's in Cloudflare. NO trailing slash.
NEXTAUTH_URL="https://yourdomain.in"

# Secrets — generate with:  openssl rand -hex 32
NEXTAUTH_SECRET="REPLACE_ME_32_BYTES_HEX"
# APP_ENCRYPTION_KEY is read nowhere — the at-rest key is INTEGRATION_ENCRYPTION_KEY (below).
APP_ENCRYPTION_KEY="REPLACE_ME_32_BYTES_HEX"

# Storage adapter. Local FS is fine for Phase 1. Bucket adapters wire up later.
STORAGE_PROVIDER="local"
UPLOADS_DIR="/var/www/restaurant-manager/uploads"

# Deployment mode flag — surfaces in /platform/system-health
DEPLOYMENT_MODE="LOW_COST_SINGLE_VPS"
LAST_BACKUP_MARKER="/var/lib/restaurant-manager/last-backup.txt"

# Cookie scope for cross-subdomain auth (uncomment once subdomain tenancy is on)
# COOKIE_DOMAIN=".yourdomain.in"

# ─── Payments ────────────────────────────────────────────────────────────────
# Each restaurant normally stores its own gateway credentials in
# Storefront CMS -> Integrations; those ALWAYS win over everything below.
# PAYMENT_PROVIDER is only the platform-wide fallback for tenants that have
# connected nothing: "phonepe" | "razorpay" (needs RAZORPAY_* keys AND a webhook
# secret) | unset. Unset/unresolvable => online payment is hidden at checkout
# (COD only) — never the mock in production.
PAYMENT_PROVIDER="phonepe"

# The public https origin. Builds the PhonePe return URL, and MUST match the
# single domain onboarded on your PhonePe merchant account or payments are
# blocked with INTERNAL_SECURITY_BLOCK_1.
NEXT_PUBLIC_SITE_URL="https://flavrly.in"

# ─── Razorpay ────────────────────────────────────────────────────────────────
# Start in TEST mode. Flip to live keys after Razorpay KYC is approved.
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME"
RAZORPAY_WEBHOOK_SECRET="REPLACE_ME"

# ─── PhonePe (Standard Checkout V2) ──────────────────────────────────────────
# V2 = OAuth credentials from PhonePe Business Dashboard -> Developer Settings.
# The legacy V1 pair (Merchant ID + Salt Key + Salt Index) is deprecated and
# fails with 404 / Key_not_configured against these endpoints.
PHONEPE_CLIENT_ID="REPLACE_ME"
PHONEPE_CLIENT_SECRET="REPLACE_ME"
PHONEPE_CLIENT_VERSION="1"
# SANDBOX for UAT, PRODUCTION once PhonePe approves go-live.
PHONEPE_ENV="SANDBOX"
# Invent any username/password pair, register the SAME pair on the PhonePe
# dashboard under Webhooks (auth type: SHA) against
#   https://<your-domain>/api/payments/phonepe/webhook
# subscribed to: checkout.order.completed, checkout.order.failed,
#                pg.refund.accepted, pg.refund.completed, pg.refund.failed
PHONEPE_WEBHOOK_USERNAME="REPLACE_ME"
PHONEPE_WEBHOOK_PASSWORD="REPLACE_ME"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for the internal cron endpoints (payment reconciliation sweep,
# KYC expiry sweep). Generate with: openssl rand -hex 32
# The PhonePe reconciliation sweep is NOT optional in production — it is what
# closes out payments whose webhook never arrived:
#   */5 * * * * curl -fsS -X POST https://<domain>/api/platform/jobs/phonepe-reconcile/run \
#                 -H "x-internal-secret: $INTERNAL_CRON_SECRET"
INTERNAL_CRON_SECRET="REPLACE_ME"

# ─── SMS — pick ONE provider ─────────────────────────────────────────────────
# MSG91 (recommended — DLT-compliant OTPs)
NOTIFIER_SMS="msg91"
MSG91_AUTH_KEY="REPLACE_ME"
MSG91_SENDER_ID="MVKFHB"
MSG91_ROUTE="4"
MSG91_DLT_TEMPLATE_ID="REPLACE_ME"

# Alternatives — pick one and comment out the MSG91 block above.
# NOTIFIER_SMS="fast2sms"
# FAST2SMS_API_KEY="REPLACE_ME"
#
# NOTIFIER_SMS="textlocal"
# TEXTLOCAL_API_KEY="REPLACE_ME"
# TEXTLOCAL_SENDER_ID="MVKFHB"

# ─── Email — pick ONE provider ───────────────────────────────────────────────
# Zoho Mail (recommended — Lite plan ₹90/user/month)
NOTIFIER_EMAIL="zoho_smtp"
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="587"
SMTP_USER="orders@yourdomain.in"
SMTP_PASS="REPLACE_ME_APP_PASSWORD"
SMTP_FROM="orders@yourdomain.in"
SMTP_SECURE="false"

# Brevo (free 300/day)
# NOTIFIER_EMAIL="brevo_smtp"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="REPLACE_ME@yourdomain.in"
# SMTP_PASS="REPLACE_ME_BREVO_KEY"
# SMTP_FROM="orders@yourdomain.in"
# SMTP_SECURE="false"

# ─── Google OAuth (optional — customer Google sign-in) ───────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://yourdomain.in/api/auth/callback/google
# GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="REPLACE_ME"

# ─── KYC verifier (rider onboarding) ─────────────────────────────────────────
# "mock" replays canned responses (dev). "surepass" hits live APIs (₹1–₹3 per
# Aadhaar/PAN/license check). "karza" is similar pricing, larger enterprise.
KYC_VERIFIER="mock"
# KYC_VERIFIER="surepass"
# SUREPASS_API_KEY="REPLACE_ME"
# SUREPASS_BASE_URL="https://kyc-api.surepass.io"

# ─── Maps (optional) ─────────────────────────────────────────────────────────
# We default to free OSM tiles via Leaflet. If you flip to Mapbox/Google later:
# MAPS_PROVIDER="mapbox"
# MAPBOX_TOKEN="REPLACE_ME"

# ─── Observability (optional but recommended) ────────────────────────────────
# Sentry — free tier covers 5k errors/month
# SENTRY_DSN="https://REPLACE_ME@sentry.io/123456"
# SENTRY_ENVIRONMENT="production"

# PostHog — free tier covers 1M events/month
# POSTHOG_KEY="phc_REPLACE_ME"
# POSTHOG_HOST="https://app.posthog.com"

# ─── Backups (read by deploy/backup.sh) ──────────────────────────────────────
# Set in /etc/default/rm-backup, not here. Listed for reference.
# RCLONE_REMOTE="b2:maverick-rm-backups"
# BACKUP_RETENTION_DAYS_LOCAL="14"
# BACKUP_RETENTION_DAYS_REMOTE="30"

# ─── Google reviews module ───────────────────────────────────────────────────
# Google Business Profile OAuth (reviews module). Create credentials in a
# Google Cloud project with the Business Profile API enabled + approved.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://flavrly.in/api/admin/integrations/google-business/callback
# INTERNAL_CRON_SECRET already documented for existing jobs — reused by the reviews sweep.
# LLM keys are NOT env vars: they are entered per-restaurant in Settings and stored
# encrypted (INTEGRATION_ENCRYPTION_KEY) in IntegrationCredential.

# ─── Env vars read by the code that were missing from this file (platform-auth r3) ───
# Commented lines are optional; the code's default applies when unset.
# -- Hosts / public URLs
# Customer host (server/hosts.ts). Default flavrly.in.
# PUBLIC_HOST="flavrly.in"
# Staff/platform portal host (server/hosts.ts). Default portal.flavrly.in.
# PORTAL_HOST="portal.flavrly.in"
# Base URL printed on coupon QR posters (admin/coupon-campaigns qr-poster).
# NEXT_PUBLIC_APP_URL="https://flavrly.in"
# Link target of the YouPI admin console button in /platform/youpi.
# NEXT_PUBLIC_YOUPI_ADMIN_URL="https://pay-admin.flavrly.in"
# Extra next/image remote host (next.config.mjs) when images are served from a CDN/object store.
# IMAGE_CDN_HOST="cdn.example.com"
# -- Brand / contact (public)
# Brand name (src/lib/brand.ts).
# NEXT_PUBLIC_BRAND_NAME="Flavrly"
# Brand tagline (src/lib/brand.ts).
# NEXT_PUBLIC_BRAND_TAGLINE=""
# Support email shown in the UI (src/lib/brand.ts).
# NEXT_PUBLIC_SUPPORT_EMAIL="support@flavrly.in"
# Privacy contact (src/lib/brand.ts).
# NEXT_PUBLIC_PRIVACY_EMAIL="privacy@flavrly.in"
# Careers contact (src/lib/brand.ts).
# NEXT_PUBLIC_CAREERS_EMAIL="careers@flavrly.in"
# Support phone (src/lib/brand.ts).
# NEXT_PUBLIC_SUPPORT_PHONE=""
# Support WhatsApp number (src/lib/brand.ts).
# NEXT_PUBLIC_SUPPORT_WHATSAPP=""
# Display currency (src/lib/brand.ts). Default INR.
# NEXT_PUBLIC_CURRENCY="INR"
# Pre-filled commission % on /platform/restaurants/new. Default 15.
# NEXT_PUBLIC_DEFAULT_COMMISSION_PCT="15"
# -- Auth
# false = only pre-registered accounts can log in (phone OTP / Google). Default true.
# ALLOW_CUSTOMER_SELF_SIGNUP="true"
# Comma-separated emergency accounts exempt from TOTP + IP allowlist (every login audited). Recovery path for a sole super-admin who lost their authenticator.
# BREAKGLASS_EMAILS=""
# -- OTP delivery
# sms | whatsapp | whatsapp_then_sms | sms_then_whatsapp | both (server/otp.ts). Default sms.
# OTP_CHANNEL="sms"
# true surfaces OTP codes (pre-launch demo only). Refused at boot when a real SMS/WhatsApp provider is configured.
# OTP_DEMO_MODE="false"
# Legacy alias of OTP_DEMO_MODE.
# OTP_DEBUG_LOG="false"
# Staging escape hatch: true disables OTP abuse limits. Never in production.
# OTP_RATE_LIMITS_DISABLED="false"
# MSG91 SendOTP template id (server/otp.ts). Falls back to MSG91_DLT_TEMPLATE_ID.
# MSG91_TEMPLATE_ID=""
# Legacy spelling of MSG91_AUTH_KEY (fallback only; set MSG91_AUTH_KEY).
# MSG91_AUTHKEY=""
# MSG91 OTP widget id (enables the widget login flow).
# NEXT_PUBLIC_MSG91_WIDGET_ID=""
# MSG91 OTP widget token.
# NEXT_PUBLIC_MSG91_WIDGET_TOKEN=""
# -- SMS / WhatsApp / email providers
# Legacy alias of NOTIFIER_SMS (read only when NOTIFIER_SMS is empty).
# SMS_PROVIDER=""
# meta | twilio_whatsapp | mock (case-insensitive).
# NOTIFIER_WHATSAPP="mock"
# 2Factor.in API key (NOTIFIER_SMS=2factor).
# TWOFACTOR_API_KEY=""
# 2Factor DLT sender/header.
# TWOFACTOR_SENDER_ID=""
# 2Factor OTP template — used ONLY for OTP messages.
# TWOFACTOR_TEMPLATE_NAME=""
# 2Factor transactional DLT template for non-OTP SMS (alerts, SOS, review asks). Unset: those go out on the plain TSMS route.
# TWOFACTOR_TSMS_TEMPLATE_NAME=""
# Fast2SMS sender id (DLT route).
# FAST2SMS_SENDER_ID=""
# Fast2SMS route: q | dlt.
# FAST2SMS_ROUTE="q"
# Fast2SMS DLT message id (route=dlt).
# FAST2SMS_MESSAGE_ID=""
# Twilio account SID (NOTIFIER_SMS=twilio / NOTIFIER_WHATSAPP=twilio_whatsapp).
# TWILIO_ACCOUNT_SID=""
# Twilio auth token.
# TWILIO_AUTH_TOKEN=""
# Twilio SMS sender number.
# TWILIO_FROM=""
# Twilio WhatsApp sender number.
# TWILIO_WHATSAPP_FROM=""
# Meta WhatsApp Cloud API phone number id (NOTIFIER_WHATSAPP=meta).
# META_WHATSAPP_PHONE_NUMBER_ID=""
# Meta permanent (system-user) access token.
# META_WHATSAPP_ACCESS_TOKEN=""
# Approved Authentication template — used ONLY for OTP messages; other WhatsApp messages go as text (24h window).
# META_WHATSAPP_TEMPLATE_NAME=""
# Template language code.
# META_WHATSAPP_TEMPLATE_LANG="en_US"
# Graph API version.
# META_WHATSAPP_API_VERSION="v21.0"
# false for a body-only OTP template (no copy-code button).
# META_WHATSAPP_COPY_CODE_BUTTON="true"
# -- Web push (VAPID)
# Web-push VAPID public key (npx web-push generate-vapid-keys). Push is disabled when unset.
# VAPID_PUBLIC_KEY=""
# Web-push VAPID private key.
# VAPID_PRIVATE_KEY=""
# VAPID subject (mailto: or https: URL).
# VAPID_SUBJECT="mailto:support@flavrly.in"
# -- Maps / geo
# Google Maps key (health probe reports whether it is configured).
# GOOGLE_MAPS_API_KEY=""
# Google Places key for the reviews module (place lookup; billing-enabled, no Business Profile access needed).
# GOOGLE_PLACES_API_KEY=""
# OSRM routing server base URL (server/geo/routing.ts). Unset: straight-line estimates.
# OSRM_URL=""
# Photon address-autocomplete base URL.
# PHOTON_URL="https://photon.komoot.io"
# Rider auto-arrival geofence radius in metres. Default 120.
# ARRIVAL_RADIUS_M="120"
# -- Google reviews real-time push
# Pub/Sub push OIDC audience. Real-time push is off unless both GBP_PUBSUB_* are set (the 15-min sweep still runs).
# GBP_PUBSUB_AUDIENCE=""
# Service-account email that signs the Pub/Sub push tokens.
# GBP_PUBSUB_SERVICE_ACCOUNT=""
# -- Storage / cache / crypto
# s3 | local (server/storage.ts).
# STORAGE_DRIVER="local"
# S3 bucket (STORAGE_DRIVER=s3).
# S3_BUCKET=""
# S3 region.
# S3_REGION=""
# S3 access key id.
# S3_ACCESS_KEY=""
# S3 secret key.
# S3_SECRET_KEY=""
# Redis for the shared cache / rate limits. Unset: in-process fallback.
# REDIS_URL=""
# Redis key prefix.
# REDIS_KEY_PREFIX="flavrly:v1:"
# AES key for IntegrationCredential + TOTP secrets at rest (server/crypto.ts). REQUIRED in production; never change it without re-encrypting.
INTEGRATION_ENCRYPTION_KEY="REPLACE_ME_openssl_rand_base64_32"
# -- KYC verifiers
# Karza API key (KYC_VERIFIER=karza).
# KARZA_API_KEY=""
# Surepass bearer token (KYC_VERIFIER=surepass).
# SUREPASS_TOKEN=""
# Makes the mock KYC verifier deterministic (tests only).
# KYC_MOCK_SEED=""
# -- Demo gate / ops
# true puts the whole site behind the demo password gate (middleware).
# DEMO_MODE="false"
# Password for the demo gate (/demo-gate).
# DEMO_GATE_PASSWORD=""
# Signs the demo-gate cookie. Falls back to NEXTAUTH_SECRET.
# DEMO_GATE_SECRET=""
# pino log level.
# LOG_LEVEL="info"
# Log directory the system-cleanup tool prunes (PM2_LOG_DIR wins).
# LOG_DIR="/var/log/restaurant-manager"
# PM2 log directory for the system-cleanup tool.
# PM2_LOG_DIR=""

# -- Client IP (src/server/http/client-ip.ts)
# true ONLY when every request provably arrives via Cloudflare (origin firewalled to CF ranges):
# then CF-Connecting-IP is trusted. Otherwise X-Real-IP (set by nginx real_ip) is used, so a
# forged CF-Connecting-IP sent straight to the origin cannot bypass the super-admin IP allowlist.
# TRUST_CF="false"

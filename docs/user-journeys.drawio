  <diagram id="journeys" name="Role Journeys v3">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="n101" value="FoodHub Marketplace — Who Does What (v3, platform-pool model)" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2620" height="36" as="geometry"/></mxCell>
<mxCell id="n102" value="Restaurants release ready orders into a shared rider pool. The platform team approves riders and sets payouts." style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#52606d;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2620" height="24" as="geometry"/></mxCell>
<mxCell id="n103" value="01 · Joining&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Becoming part of the marketplace&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n104" value="02 · Discovering&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Customer browses the catalogue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n105" value="03 · Ordering&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Items, payment, confirmation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n106" value="04 · Cooking&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Kitchen workflow&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1490" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n107" value="05 · Delivering&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Rider hand-off and live tracking&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1910" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n108" value="06 · After&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Loyalty, tips, growth&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2330" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n109" value="👤  Customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="180" height="165" as="geometry"/></mxCell>
<mxCell id="n110" value="Discovers FoodHub via referral, social, or search.&lt;br&gt;&lt;br&gt;Just opens the home page — browses freely. No signup needed to look around." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="175" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n111" value="Browses restaurants near them. Filters veg / non-veg, sees photos, prep times, popular picks.&lt;br&gt;&lt;br&gt;Opens a menu, scrolls combos, dishes, and the &#x27;Most ordered here&#x27; strip." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="650" y="175" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n112" value="Adds items to cart. Applies a coupon. Uses wallet or loyalty points if available.&lt;br&gt;&lt;br&gt;Pays via UPI / card / Cash on Delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1070" y="175" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n113" value="Watches order status update live.&lt;br&gt;&lt;br&gt;Received → Accepted → Preparing → Ready. Gets SMS at every step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1490" y="175" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n114" value="Sees the rider&#x27;s pin moving on a live map.&lt;br&gt;&lt;br&gt;Calls or messages if needed. Hands the rider a 4-digit code to confirm safe delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="175" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n115" value="Sees the order in &#x27;My orders&#x27;.&lt;br&gt;&lt;br&gt;One-tap re-order. &lt;b&gt;Tips the rider&lt;/b&gt; (100% to the rider). Earns loyalty points. Shares referral code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="175" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n116" value="🏪  Restaurant&lt;br&gt;(Owner + Kitchen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=#e65100;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="180" height="165" as="geometry"/></mxCell>
<mxCell id="n117" value="Owner signs up at FoodHub → submits name, cuisine, address, login.&lt;br&gt;&lt;br&gt;Status = Pending until platform team approves (~24h)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="346" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n118" value="Their restaurant page, menu, photos, hours go live the moment platform approves.&lt;br&gt;&lt;br&gt;Featured on the homepage when newly added." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="650" y="346" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n119" value="Sees new orders the instant they arrive (live notification).&lt;br&gt;&lt;br&gt;One tap to Accept or Reject. Prints a kitchen ticket." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1070" y="346" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n120" value="&lt;b&gt;👤 Owner:&lt;/b&gt; monitors prep board, prints tickets, toggles items in/out of stock.&lt;br&gt;&lt;br&gt;&lt;b&gt;👨‍🍳 Kitchen staff:&lt;/b&gt; touch-friendly tablet — tap to start cooking, tap when ready. Overdue orders flagged red." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1490" y="346" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n121" value="&lt;b&gt;Marks order Ready → releases to the platform rider pool.&lt;/b&gt;&lt;br&gt;&lt;br&gt;No manual rider assignment. Sees a &#x27;waiting for a rider&#x27; indicator, then &#x27;picked up&#x27; once a rider claims it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="346" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n122" value="Daily dashboard: orders, revenue, best sellers, peak hours.&lt;br&gt;&lt;br&gt;Excel export for accountant. Opens new branches when ready to scale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="346" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n123" value="🛵  Rider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="180" height="165" as="geometry"/></mxCell>
<mxCell id="n124" value="Applies via &#x27;Become a rider&#x27; on FoodHub.&lt;br&gt;&lt;br&gt;&lt;b&gt;Approved by the platform team, not by any restaurant.&lt;/b&gt; Gets an SMS to sign in once approved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="517" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n125" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650" y="517" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n126" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1070" y="517" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n127" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1490" y="517" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n128" value="Toggle ONLINE → sees every restaurant&#x27;s READY orders in the &lt;b&gt;pool&lt;/b&gt;.&lt;br&gt;&lt;br&gt;First to claim wins. Picks up at the restaurant, drives to customer, snaps proof photo, verifies 4-digit code, marks Delivered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="517" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n129" value="Sees today&#x27;s earnings: base + bonus + tips.&lt;br&gt;&lt;br&gt;Lifetime stats. Customer tips arrive instantly. Capacitor APK on Play Store." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="517" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n130" value="🛡️  Platform Team&lt;br&gt;(FoodHub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="180" height="165" as="geometry"/></mxCell>
<mxCell id="n131" value="Reviews new restaurant applications. Approves quality kitchens, rejects spammy ones.&lt;br&gt;&lt;br&gt;&lt;b&gt;Also reviews rider applications&lt;/b&gt; (platform-wide, not per-restaurant). Sets per-restaurant commission %." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="688" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n132" value="—  Optional: features curated restaurants on the homepage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650" y="688" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n133" value="—  Earns commission % on every paid order in the background." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1070" y="688" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n134" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1490" y="688" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n135" value="&lt;b&gt;Sets the delivery payout rules:&lt;/b&gt; base ₹ per delivery, ₹ per km, peak-hour and rain-day bonuses.&lt;br&gt;&lt;br&gt;Pool spreads orders to whichever rider claims them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="688" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="n136" value="Cross-marketplace deep analytics: GMV, top restaurants and products, peak hours, payment mix, rider leaderboard.&lt;br&gt;&lt;br&gt;Can suspend non-compliant restaurants or revoke rider approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="688" width="415" height="165" as="geometry"/></mxCell>
<mxCell id="e137" value="submits for approval" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#6a1b9a;fontSize=10;fontStyle=1;fontColor=#6a1b9a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n117" target="n131"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e138" value="approves, goes live" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#e65100;fontSize=10;fontStyle=1;fontColor=#e65100;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n131" target="n117"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e139" value="applies" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#2e7d32;fontSize=10;fontStyle=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n124" target="n131"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e140" value="new order alert" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#1976d2;fontSize=10;fontStyle=1;fontColor=#1976d2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n112" target="n119"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e141" value="live status" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#e65100;fontSize=10;fontStyle=1;fontColor=#e65100;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n120" target="n113"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e142" value="released to pool" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#6a1b9a;fontSize=10;fontStyle=1;fontColor=#6a1b9a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n121" target="n128"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e143" value="delivered + photo" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#2e7d32;fontSize=10;fontStyle=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n128" target="n114"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e144" value="commission %" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#6a1b9a;fontSize=10;fontStyle=1;fontColor=#6a1b9a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n122" target="n136"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e145" value="tip" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#1976d2;fontSize=10;fontStyle=1;fontColor=#1976d2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n115" target="n129"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n146" value="⚠️  When things go wrong  (edge-case journeys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#bf360c;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="2620" height="32" as="geometry"/></mxCell>
<mxCell id="n147" value="&lt;b&gt;Customer cancels&lt;/b&gt;&lt;br&gt;Before accept → instant refund." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="40.0" y="1468" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n148" value="&lt;b&gt;Restaurant rejects&lt;/b&gt;&lt;br&gt;Out of stock → full refund auto-issued." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="478.3333333333333" y="1468" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n149" value="&lt;b&gt;Payment fails&lt;/b&gt;&lt;br&gt;Cart preserved · retry or COD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="916.6666666666666" y="1468" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n150" value="&lt;b&gt;Pool empty too long&lt;/b&gt;&lt;br&gt;Platform alerts: surge bonus or auto-cancel." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="1355.0" y="1468" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n151" value="&lt;b&gt;Low rating ≤ 2★&lt;/b&gt;&lt;br&gt;Support case opens · credit decided case-by-case." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="1793.3333333333333" y="1468" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n152" value="&lt;b&gt;Photo unclear&lt;/b&gt;&lt;br&gt;Customer can dispute · platform reviews." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="2231.6666666666665" y="1468" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n153" value="Reading the diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="800" height="28" as="geometry"/></mxCell>
<mxCell id="n154" value="&lt;b&gt;Each lane = one role.&lt;/b&gt;  Read left-to-right.  &lt;b&gt;Coloured arrows = handoffs between roles&lt;/b&gt; — arrow colour matches the role initiating the handoff.  &lt;b&gt;Dashed grey cells&lt;/b&gt; = role not active in that phase.&lt;br&gt;&lt;br&gt;&lt;b&gt;Key change from v2:&lt;/b&gt; riders are now platform-managed.  Restaurants no longer assign riders — they release ready orders into a shared pool that any approved online rider can claim.&lt;br&gt;&lt;br&gt;&lt;b&gt;The orange band above&lt;/b&gt; covers exception flows (cancel, reject, payment failure, complaint, rider photo dispute)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#cbd2d9;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;fontColor=#3e4c59;" vertex="1" parent="1"><mxGeometry x="40" y="1662" width="1500" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

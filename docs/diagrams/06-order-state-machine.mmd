stateDiagram-v2
    [*] --> PAYMENT_PENDING
    PAYMENT_PENDING --> RECEIVED: Razorpay OK / COD
    PAYMENT_PENDING --> PAYMENT_FAILED: webhook fail
    PAYMENT_PENDING --> CANCELLED_BY_CUSTOMER
    PAYMENT_PENDING --> CANCELLED_BY_ADMIN
    PAYMENT_FAILED --> RECEIVED: retry
    PAYMENT_FAILED --> CANCELLED: auto 30m

    RECEIVED --> ACCEPTED
    RECEIVED --> CANCELLED_BY_CUSTOMER
    RECEIVED --> CANCELLED_BY_RESTAURANT

    ACCEPTED --> PREPARING
    ACCEPTED --> CANCELLED_BY_RESTAURANT

    PREPARING --> READY
    PREPARING --> CANCELLED_BY_RESTAURANT

    READY --> RIDER_ASSIGNED
    READY --> OUT_FOR_DELIVERY
    READY --> CANCELLED_BY_ADMIN: no rider 20m

    RIDER_ASSIGNED --> RIDER_REACHED_RESTAURANT
    RIDER_ASSIGNED --> PICKED_UP
    RIDER_ASSIGNED --> OUT_FOR_DELIVERY

    RIDER_REACHED_RESTAURANT --> PICKED_UP
    PICKED_UP --> OUT_FOR_DELIVERY
    PICKED_UP --> RIDER_REACHED_CUSTOMER
    PICKED_UP --> DELIVERY_FAILED

    OUT_FOR_DELIVERY --> RIDER_REACHED_CUSTOMER
    OUT_FOR_DELIVERY --> DELIVERED
    OUT_FOR_DELIVERY --> DELIVERY_FAILED
    OUT_FOR_DELIVERY --> CANCELLED_BY_ADMIN

    RIDER_REACHED_CUSTOMER --> DELIVERED: OTP verified
    RIDER_REACHED_CUSTOMER --> DELIVERY_OTP_FAILED
    RIDER_REACHED_CUSTOMER --> CUSTOMER_UNREACHABLE
    RIDER_REACHED_CUSTOMER --> DELIVERY_FAILED

    DELIVERY_OTP_FAILED --> DELIVERED: admin override
    DELIVERY_OTP_FAILED --> DELIVERY_FAILED
    CUSTOMER_UNREACHABLE --> DELIVERED
    CUSTOMER_UNREACHABLE --> DELIVERY_FAILED

    DELIVERY_FAILED --> REFUND_PENDING
    DELIVERED --> REFUND_PENDING: dispute
    DELIVERED --> REFUND_INITIATED: admin refund

    CANCELLED_BY_CUSTOMER --> REFUND_PENDING
    CANCELLED_BY_RESTAURANT --> REFUND_PENDING
    CANCELLED_BY_ADMIN --> REFUND_PENDING

    REFUND_PENDING --> REFUND_INITIATED
    REFUND_PENDING --> REFUNDED
    REFUND_INITIATED --> REFUNDED

    DELIVERED --> [*]
    REFUNDED --> [*]
    CANCELLED --> [*]

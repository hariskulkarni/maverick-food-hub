  <diagram id="journeys" name="Role Journeys">
    <mxGraphModel dx="1422" dy="757" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
<mxCell id="n101" value="FoodHub Marketplace — Who Does What" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2620" height="36" as="geometry"/></mxCell>
<mxCell id="n102" value="How customers, restaurants, riders and the platform team work together to fulfil every order" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#52606d;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2620" height="24" as="geometry"/></mxCell>
<mxCell id="n103" value="🚪  Joining FoodHub&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Becoming part of the marketplace&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n104" value="🔍  Discovering food&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Customer browses the menu&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n105" value="🛒  Placing the order&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Items, payment, confirmation&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n106" value="👨‍🍳  Cooking the food&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Restaurant + kitchen workflow&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1490" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n107" value="🛵  Out for delivery&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Rider hand-off + live tracking&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1910" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n108" value="💚  After the order&lt;br&gt;&lt;span style=&quot;font-size:10px;font-weight:normal;color:#cfd8dc&quot;&gt;Loyalty, growth, insights&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474f;strokeColor=#263238;fontSize=13;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2330" y="100" width="415" height="56" as="geometry"/></mxCell>
<mxCell id="n109" value="👤  Customer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#90caf9;strokeColor=#1976d2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="180" height="175" as="geometry"/></mxCell>
<mxCell id="n110" value="Discovers FoodHub via referral or search.&lt;br&gt;&lt;br&gt;Just opens the home page — browses freely. No signup needed to look around." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="175" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n111" value="Browses restaurants near them.&lt;br&gt;&lt;br&gt;Filters veg / non-veg, sees photos, prep times, popular picks. Opens a menu, scrolls combos and dishes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="650" y="175" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n112" value="Adds items to cart. Applies a coupon (e.g. WELCOME50).&lt;br&gt;&lt;br&gt;Uses wallet or loyalty points if available. Pays via UPI / card / Cash on Delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1070" y="175" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n113" value="Watches order status update live.&lt;br&gt;&lt;br&gt;Received → Accepted → Preparing → Ready. Gets an SMS at every step." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1490" y="175" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n114" value="Sees the rider&#x27;s pin moving on a live map.&lt;br&gt;&lt;br&gt;Calls or messages if needed. Hands the rider a 4-digit code to confirm safe delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="175" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n115" value="Sees the order in &#x27;My orders&#x27;.&lt;br&gt;&lt;br&gt;One-tap re-order. Earns loyalty points on every paid order. Shares referral code → both sides earn a reward." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="175" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n116" value="🏪  Restaurant&lt;br&gt;(Owner + Kitchen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffb74d;strokeColor=#e65100;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="180" height="175" as="geometry"/></mxCell>
<mxCell id="n117" value="Owner signs up at FoodHub → submits restaurant name, cuisine, address, login.&lt;br&gt;&lt;br&gt;Status = Pending until platform team approves (~24h)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="356" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n118" value="Their restaurant page, menu, photos, hours go live the moment platform approves.&lt;br&gt;&lt;br&gt;Featured on the homepage when newly added." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="650" y="356" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n119" value="Sees new orders the instant they arrive (live notification).&lt;br&gt;&lt;br&gt;One tap to Accept or Reject. Prints a kitchen ticket." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1070" y="356" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n120" value="&lt;b&gt;👤 Owner:&lt;/b&gt; monitors prep board, updates pricing or in-stock status, prints tickets.&lt;br&gt;&lt;br&gt;&lt;b&gt;👨‍🍳 Kitchen staff:&lt;/b&gt; use a touch-friendly tablet board — tap to start cooking, tap when ready. Overdue orders flagged in red." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1490" y="356" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n121" value="Assigns the order to a rider.&lt;br&gt;&lt;br&gt;Picks manually from suggestions, OR lets the system auto-pick the best one (closest, lightest load)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="356" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n122" value="Daily dashboard: orders, revenue, best sellers, peak hours.&lt;br&gt;&lt;br&gt;One-click Excel export for accountant. Approves new rider applicants. Opens new branches when ready to scale." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="356" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n123" value="🛵  Rider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="537" width="180" height="175" as="geometry"/></mxCell>
<mxCell id="n124" value="Applies via &#x27;Become a rider&#x27; → picks which restaurant they want to ride for.&lt;br&gt;&lt;br&gt;Provides name, phone, vehicle. Restaurant approves and they get an SMS to log in." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="537" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n125" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650" y="537" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n126" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1070" y="537" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n127" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1490" y="537" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n128" value="Toggles ONLINE → starts sharing live location.&lt;br&gt;&lt;br&gt;Receives an assignment → accepts → picks up at restaurant → drives to customer → verifies 4-digit code → marks Delivered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1910" y="537" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n129" value="Sees today&#x27;s earnings + lifetime delivery count.&lt;br&gt;&lt;br&gt;Reviews delivery history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="537" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n130" value="🛡️  Platform Team&lt;br&gt;(FoodHub)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="718" width="180" height="175" as="geometry"/></mxCell>
<mxCell id="n131" value="Reviews new restaurant applications.&lt;br&gt;&lt;br&gt;Approves quality kitchens, rejects spammy ones. Sets commission % per restaurant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="230" y="718" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n132" value="—  Optional: features curated restaurants on the homepage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650" y="718" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n133" value="—  Earns commission % on every paid order in the background." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1070" y="718" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n134" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1490" y="718" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n135" value="—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#bdbdbd;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1910" y="718" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="n136" value="Cross-marketplace dashboard: total order value, active restaurants, riders online, orders/hour.&lt;br&gt;&lt;br&gt;Can suspend non-compliant restaurants. Manages overall marketplace health." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="2330" y="718" width="415" height="175" as="geometry"/></mxCell>
<mxCell id="e137" value="submits for approval" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#6a1b9a;fontSize=10;fontStyle=1;fontColor=#6a1b9a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n117" target="n131"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e138" value="approves, restaurant goes live" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#e65100;fontSize=10;fontStyle=1;fontColor=#e65100;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n131" target="n117"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e139" value="rider applies" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#2e7d32;fontSize=10;fontStyle=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n124" target="n117"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e140" value="new order alert" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#1976d2;fontSize=10;fontStyle=1;fontColor=#1976d2;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n112" target="n119"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e141" value="live status updates" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#e65100;fontSize=10;fontStyle=1;fontColor=#e65100;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n120" target="n113"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e142" value="assigned" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#e65100;fontSize=10;fontStyle=1;fontColor=#e65100;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n121" target="n128"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e143" value="delivered + verified" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#2e7d32;fontSize=10;fontStyle=1;fontColor=#2e7d32;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n128" target="n114"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e144" value="commission %" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#6a1b9a;fontSize=10;fontStyle=1;fontColor=#6a1b9a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n122" target="n136"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n145" value="⚠️  When things go wrong  (edge-case journeys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ef6c00;strokeColor=#bf360c;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="929" width="2620" height="32" as="geometry"/></mxCell>
<mxCell id="n146" value="&lt;b&gt;Customer cancels&lt;/b&gt;&lt;br&gt;Before restaurant accepts → instant refund to original payment method or wallet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="40.0" y="967" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n147" value="&lt;b&gt;Restaurant rejects&lt;/b&gt;&lt;br&gt;Kitchen too busy / item out of stock → customer notified, full refund auto-issued." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="478.3333333333333" y="967" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n148" value="&lt;b&gt;Payment fails&lt;/b&gt;&lt;br&gt;Cart preserved. Customer can retry with a different method or switch to Cash on Delivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="916.6666666666666" y="967" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n149" value="&lt;b&gt;Order is delayed&lt;/b&gt;&lt;br&gt;&gt;45 min → flagged as priority. Restaurant + platform notified. Customer offered apology credit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="1355.0" y="967" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n150" value="&lt;b&gt;Customer rates 1–5★&lt;/b&gt;&lt;br&gt;Low ratings (≤2★) opened as a support case. Refund/credit decided case-by-case." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="1793.3333333333333" y="967" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n151" value="&lt;b&gt;Refund returned to wallet&lt;/b&gt;&lt;br&gt;Used on next order — keeps customers in the marketplace instead of disputing with their bank." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ef6c00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontColor=#bf360c;" vertex="1" parent="1"><mxGeometry x="2231.6666666666665" y="967" width="428.3333333333333" height="110" as="geometry"/></mxCell>
<mxCell id="n152" value="💰  How money flows on a typical order  (food subtotal ₹500)" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="40" y="1107" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="n153" value="Tax and delivery fee are charged separately on top of the food subtotal and don&#x27;t change the split below." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#52606d;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1137" width="1100" height="18" as="geometry"/></mxCell>
<mxCell id="n154" value="👤 Customer pays&lt;br&gt;&lt;span style=&#x27;font-size:20px;font-weight:bold&#x27;&gt;₹500&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;food subtotal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="40" y="1167" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="n155" value="Splits into&lt;br&gt;&lt;span style=&#x27;font-size:11px;font-weight:normal&#x27;&gt;two parts at checkout&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="370" y="1167" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="n156" value="🏪 Restaurant earns&lt;br&gt;&lt;span style=&#x27;font-size:20px;font-weight:bold&#x27;&gt;₹450&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;90% of food subtotal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#e65100;" vertex="1" parent="1"><mxGeometry x="700" y="1167" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="n157" value="🛡️ Platform commission&lt;br&gt;&lt;span style=&#x27;font-size:20px;font-weight:bold&#x27;&gt;₹50&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;10% of food subtotal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9c27b0;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#4a148c;" vertex="1" parent="1"><mxGeometry x="1030" y="1167" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="n158" value="🛵 Rider earns&lt;br&gt;&lt;span style=&#x27;font-size:20px;font-weight:bold&#x27;&gt;₹25&lt;/span&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;font-weight:normal&#x27;&gt;per-delivery payout, from delivery fee&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontSize=12;align=center;verticalAlign=middle;fontStyle=1;fontColor=#1b5e20;" vertex="1" parent="1"><mxGeometry x="1030" y="1273" width="280" height="90" as="geometry"/></mxCell>
<mxCell id="e159" value="" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#9c27b0;fontSize=10;fontStyle=1;fontColor=#9c27b0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n154" target="n155"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e160" value="90%" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#fb8c00;fontSize=10;fontStyle=1;fontColor=#fb8c00;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n155" target="n156"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e161" value="10%" style="endArrow=classic;html=1;rounded=1;strokeWidth=2.4;strokeColor=#9c27b0;fontSize=10;fontStyle=1;fontColor=#9c27b0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n155" target="n157"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="n162" value="Reading the diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="1380" y="1107" width="800" height="28" as="geometry"/></mxCell>
<mxCell id="n163" value="&lt;b&gt;Each lane = one role.&lt;/b&gt;  Read left-to-right to follow that role&#x27;s journey through the order lifecycle.&lt;br&gt;&lt;br&gt;&lt;b&gt;Coloured arrows = handoffs between roles.&lt;/b&gt;  Arrow colour matches the role doing the action (e.g. orange for restaurant).&lt;br&gt;&lt;br&gt;&lt;b&gt;Dashed grey cells&lt;/b&gt; mean that role is not active in that phase.&lt;br&gt;&lt;br&gt;&lt;b&gt;Two journeys overlap on this page:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;• A new &lt;b&gt;restaurant or rider&lt;/b&gt; goes through the leftmost column once when they join.&lt;br&gt;&amp;nbsp;&amp;nbsp;• A &lt;b&gt;customer order&lt;/b&gt; flows left-to-right through phases 2 → 6 every time someone orders.&lt;br&gt;&lt;br&gt;&lt;b&gt;The orange band above&lt;/b&gt; covers exception paths (cancel, reject, payment failure, complaint)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#cbd2d9;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingRight=10;fontColor=#3e4c59;" vertex="1" parent="1"><mxGeometry x="1380" y="1139" width="800" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>


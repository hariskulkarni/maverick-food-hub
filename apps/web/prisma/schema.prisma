  costPerUnit  Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]
  menuItem  MenuItem?

  @@unique([branchId, name])
}

model InventoryMovement {
  id         String                @id @default(cuid())
  itemId     String
  type       InventoryMovementType
  quantity   Decimal               @db.Decimal(12, 3)
  note       String?
  refOrderId String?
  createdAt  DateTime              @default(now())

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Notifications log
// ─────────────────────────────────────────────────────────────────────────────

// Integration credentials are encrypted at rest (AES-256-GCM) and scoped to a
// restaurant. The dispatcher consults this table before falling back to env.
model IntegrationCredential {
  id              String              @id @default(cuid())
  restaurantId    String
  provider        IntegrationProvider
  status          IntegrationStatus   @default(DISCONNECTED)
  // configEncrypted is base64(iv ‖ authTag ‖ ciphertext) — JSON of provider keys
  configEncrypted String
  // public summary, safe to show in the UI (masked key tails, account names…)
  summary         Json?
  lastTestedAt    DateTime?
  lastError       String?
  createdById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, provider])
  @@index([provider, status])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  to        String // phone or email
  subject   String?
  body      String
  template  String?
  meta      Json?
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([channel, status])
}

// ─────────────────────────────────────────────────────────────────────────────
//  AlertDebounce — short-window suppression for repeated menu/integration alerts
// ─────────────────────────────────────────────────────────────────────────────
// Stores the last time we fired a given (entityType, entityId, kind) alert so
// repeated toggles within a debounce window don't spam admin inboxes. Examples
// of `kind`:
//   - "menu.item.toggle"
//   - "menu.category.toggle"
//   - "menu.combo.toggle"
//   - "menu.bulk_toggle"
//   - "integration.update"
//   - "integration.test"
// The resolver upserts on every successful send. A background job (later) can
// prune rows older than the debounce window.
model AlertDebounce {
  id         String   @id @default(cuid())
  entityType String // e.g. "MenuItem" / "Category" / "Combo" / "IntegrationCredential"
  entityId   String
  kind       String
  lastSentAt DateTime
  payload    Json? // snapshot of the last alert content for diagnostics

  @@unique([entityType, entityId, kind])
  @@index([lastSentAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Phase 1 hardening — production survival logic
// ─────────────────────────────────────────────────────────────────────────────

// Per-phone OTP attempt tracking. Powers rate-limit logic so SMS cost stays
// bounded even under abuse. Read at request-otp time, updated on send/verify.
model OtpAttempt {
  id          String     @id @default(cuid())
  phone       String
  ipAddress   String?
  deviceHash  String?
  purpose     OtpPurpose @default(LOGIN)
  // Number of failed verify attempts on the most recent code
  attempts    Int        @default(0)
  // Total OTPs issued to this phone/ip in the current window
  sentCount   Int        @default(0)
  lockedUntil DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([phone, createdAt])
  @@index([ipAddress, createdAt])
}

// Stuck-order detector writes here. The /platform/live-ops dashboard shows
// open escalations as cards; admins acknowledge or resolve.
model OrderEscalation {
  id         String             @id @default(cuid())
  orderId    String
  type       EscalationType
  severity   EscalationSeverity @default(MEDIUM)
  status     EscalationStatus   @default(OPEN)
  message    String
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orderId, createdAt])
}

// Cash-on-delivery collection state. One row per COD order; lifecycle moves
// from PENDING_COLLECTION → COLLECTED → DEPOSIT_PENDING → RECONCILED.
model CodCollection {
  id              String    @id @default(cuid())
  orderId         String    @unique
  riderId         String
  amountToCollect Decimal   @db.Decimal(10, 2)
  amountCollected Decimal?  @db.Decimal(10, 2)
  status          CodStatus @default(PENDING_COLLECTION)
  collectedAt     DateTime?
  reconciledAt    DateTime?
  reconciledBy    String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Restrict)

  @@index([riderId, status])
  @@index([status, createdAt])
}

// Raw payment webhook payloads. Persisting ensures idempotency (we never
// process the same webhook twice) and gives us a forensic trail.
model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  eventType       String
  paymentId       String?
  orderId         String?
  // Provider's unique event ID — used for idempotency lookup
  providerEventId String?   @unique
  signature       String?
  rawPayload      Json
  processed       Boolean   @default(false)
  error           String?
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([provider, eventType, createdAt])
  @@index([orderId])
}

// Append-only audit log for sensitive admin actions. Never updated, never
// deleted. Indexed for "show me everything actor X did in the last week"
// and "show me everything that happened to restaurant Y".
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actorRole    String?
  restaurantId String?
  action       String // e.g. "restaurant.approve", "payout.adjust"
  entityType   String // e.g. "Restaurant", "Order"
  entityId     String?
  before       Json?
  after        Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([restaurantId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// Database-backed job queue. Cheap alternative to Redis/BullMQ for Phase 1.
// A small worker process polls runAt <= now() and status=PENDING.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

// Application error log. Cheap alternative to Sentry — admin /platform/system-health
// lists recent rows. Useful for triage on a single-VPS deployment.
model ErrorLog {
  id        String   @id @default(cuid())
  level     String // "error" | "warn" | "info"
  source    String // module/file name
  message   String
  stack     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
}

// ─── Phase 3/4 feature surface ──────────────────────────────────────────────

enum QrType {
  RESTAURANT
  BRANCH
  TABLE
  CAMPAIGN
  TAKEAWAY
}

// QR codes are how customers reach the storefront in Phase 1 (no customer app).
// `code` is the short slug used in the URL: /qr/<code>.
model QrCode {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String?
  tableId      String?
  code         String   @unique
  type         QrType   @default(RESTAURANT)
  campaignName String?
  scanCount    Int      @default(0)
  // Conversion tracking: orders placed from sessions originating with this QR
  orderCount   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive])
  @@index([code])
}

// Customer retention — favorite restaurants and items.
model FavoriteRestaurant {
  id           String   @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
}

model FavoriteItem {
  id         String   @id @default(cuid())
  userId     String
  menuItemId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
}

// Rider liveness — set every 30s while the rider app is online. Used by the
// auto-offline sweep to flip riders to offline if they go dark.
// (Fields here would normally live on RiderProfile; using a separate model
// keeps the migration additive without touching existing rider columns.)
model RiderHeartbeat {
  id             String    @id @default(cuid())
  riderId        String    @unique
  lastSeenAt     DateTime  @default(now())
  lastLocationAt DateTime?
  batteryLevel   Int?
  gpsEnabled     Boolean   @default(true)
  appVersion     String?
  updatedAt      DateTime  @updatedAt

  @@index([lastSeenAt])
}

enum AppPlatform {
  ANDROID_RIDER
  IOS_RIDER
  WEB
}

// Force-update / min-version control for the Capacitor rider app.
model AppVersion {
  id            String      @id @default(cuid())
  platform      AppPlatform
  minVersion    String
  latestVersion String
  forceUpdate   Boolean     @default(false)
  updateUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([platform])
}

enum TicketType {
  ORDER_DELAY
  WRONG_ITEM
  MISSING_ITEM
  PAYMENT_ISSUE
  REFUND_REQUEST
  RIDER_ISSUE
  FOOD_QUALITY
  DELIVERY_NOT_RECEIVED
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id           String         @id @default(cuid())
  orderId      String?
  customerId   String?
  restaurantId String?
  riderId      String?
  type         TicketType
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(NORMAL)
  message      String
  assignedTo   String?
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, priority, createdAt])
  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Rider KYC — Aadhaar / DL / RC / Insurance / PAN document collection
// ─────────────────────────────────────────────────────────────────────────────

enum KycDocumentType {
  AADHAAR
  DRIVING_LICENSE
  VEHICLE_INSURANCE
  VEHICLE_RC
  PAN_CARD
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// One current document per (rider, type). On replace we either overwrite the
/// row or move the old one to a history table — for Phase 1 we overwrite and
/// rely on AuditLog for the trail. Sensitive numbers are encrypted at rest;
/// only the last 4 chars are stored in plaintext for masked UI display.
model RiderKycDocument {
  id      String            @id @default(cuid())
  riderId String
  type    KycDocumentType
  status  KycDocumentStatus @default(PENDING)

  // Document number — encrypted blob using existing src/server/crypto.ts helpers
  // (AES-256-GCM, base64 of iv ‖ authTag ‖ ciphertext). `numberLast4` is the
  // only plaintext fragment ever shown back to the rider or admin in the UI.
  numberEncrypted String?
  numberLast4     String?

  // File metadata — actual file lives behind storage() driver
  fileUrl      String
  fileName     String?
  fileSize     Int?
  fileMimeType String?

  // Document dates
  issuedOn  DateTime?
  expiresOn DateTime?

  // Review workflow
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  // Audit trail signal
  uploadedFromIp String?
  updatedAt      DateTime @updatedAt

  // Live-verification metadata. Populated when an external verifier runs.
  // Null `verifierProvider` means we never attempted live verification
  // (e.g. format-only mock or pre-paid-API state).
  verifierProvider    String? // 'mock' | 'karza' | 'surepass' | 'signzy'
  verifierStatus      String? // 'PENDING' | 'PASS' | 'FAIL' | 'ERROR' | 'UNSUPPORTED'
  verifierMessage     String? // human-readable explanation
  verifierResponse    Json? // raw vendor payload (for forensics + admin review)
  verifierExternalRef String? // vendor's transaction id
  verifiedAt          DateTime?

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([riderId, type])
  @@index([status, submittedAt])
  @@index([expiresOn])
}

// ═════════════════════════════════════════════════════════════════════════════
//  Rider competitor-feature bundles (2026-05-14) — bringing the native rider
//  app to parity with the leading India delivery-partner apps.
//  Bundle A: Earnings & Payments   Bundle B: Safety & SOS
//  Bundle C: Smart dispatch        Bundle D: Growth & support
// ═════════════════════════════════════════════════════════════════════════════

// ─── Bundle A · Earnings & Payments ──────────────────────────────────────────

enum RiderPayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
}

/// An instant-withdrawal request — rider pulls their available balance to UPI
/// / bank. Demo settles via a mock processor; status walks REQUESTED→PAID.
model RiderPayout {
  id          String            @id @default(cuid())
  riderId     String
  amount      Decimal           @db.Decimal(10, 2)
  status      RiderPayoutStatus @default(REQUESTED)
  method      String            @default("UPI") // UPI | BANK
  upiId       String?
  reference   String? // mock processor txn id
  note        String?
  requestedAt DateTime          @default(now())
  processedAt DateTime?

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, status])
  @@index([status, requestedAt])
}

enum IncentivePeriod {
  DAILY
  WEEKLY
}

/// Super-admin-defined incentive slabs: "complete N deliveries in a period →
/// flat bonus". Riders see live progress; achieved slabs feed bonus payouts.
model RiderIncentive {
  id               String          @id @default(cuid())
  title            String
  description      String?
  period           IncentivePeriod @default(DAILY)
  targetDeliveries Int
  bonusAmount      Decimal         @db.Decimal(10, 2)
  startsAt         DateTime        @default(now())
  endsAt           DateTime?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())

  progress RiderIncentiveProgress[]

  @@index([isActive])
}

/// Per-rider, per-period progress against an incentive slab. `periodKey` is the
/// local day ("2026-05-14") or ISO week ("2026-W20") the progress belongs to.
model RiderIncentiveProgress {
  id             String    @id @default(cuid())
  incentiveId    String
  riderId        String
  periodKey      String
  deliveriesDone Int       @default(0)
  achieved       Boolean   @default(false)
  achievedAt     DateTime?
  bonusPaid      Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  incentive RiderIncentive @relation(fields: [incentiveId], references: [id], onDelete: Cascade)
  rider     RiderProfile   @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([incentiveId, riderId, periodKey])
  @@index([riderId])
}

/// A geofenced area with a pay multiplier active for a window — "surge". The
/// app shows riders where (and how much) extra they'll earn right now.
model SurgeZone {
  id         String    @id @default(cuid())
  name       String
  label      String    @default("Busy area")
  centerLat  Float
  centerLng  Float
  radiusKm   Float     @default(2.0)
  multiplier Float     @default(1.5)
  isActive   Boolean   @default(true)
  activeFrom DateTime?
  activeTo   DateTime?
  createdAt  DateTime  @default(now())

  @@index([isActive])
}

// ─── Bundle B · Safety & SOS ─────────────────────────────────────────────────

/// A trusted contact the rider can loop in during an emergency or live-trip
/// share. The primary contact is auto-notified on SOS.
model RiderEmergencyContact {
  id        String   @id @default(cuid())
  riderId   String
  name      String
  phone     String
  relation  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
}

enum SosStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

/// A panic-button event. Captures the rider's location at trigger time so
/// support / emergency contacts can respond. Lifecycle: ACTIVE→RESOLVED.
model SosAlert {
  id           String    @id @default(cuid())
  riderId      String
  assignmentId String?
  lat          Float?
  lng          Float?
  status       SosStatus @default(ACTIVE)
  note         String?
  triggeredAt  DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedNote String?

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, status])
  @@index([status, triggeredAt])
}

enum IncidentType {
  ACCIDENT
  HARASSMENT
  VEHICLE_BREAKDOWN
  THEFT
  UNSAFE_LOCATION
  CUSTOMER_DISPUTE
  OTHER
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

/// A rider-filed incident report (accident, harassment, breakdown…). Optional
/// photo + geotag. Reviewed by platform safety ops.
model RiderIncidentReport {
  id           String         @id @default(cuid())
  riderId      String
  assignmentId String?
  type         IncidentType
  status       IncidentStatus @default(OPEN)
  description  String
  lat          Float?
  lng          Float?
  photoUrl     String?
  resolution   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, status])
  @@index([status, createdAt])
}

/// A shareable live-trip link. The `token` resolves to a public read-only page
/// that shows the rider's live location until `expiresAt`.
model TripShare {
  id           String   @id @default(cuid())
  riderId      String
  assignmentId String?
  token        String   @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, isActive])
}

// ─── Bundle C · Smart dispatch & navigation ──────────────────────────────────

enum ShiftStatus {
  BOOKED
  STARTED
  COMPLETED
  MISSED
  CANCELLED
}

/// A booked work slot. Riders reserve high-demand windows in advance; ops use
/// it for supply planning. `zoneName` is a free-text preferred area.
model RiderShift {
  id        String      @id @default(cuid())
  riderId   String
  date      DateTime    @db.Date
  startTime String // "HH:MM" local
  endTime   String // "HH:MM" local
  zoneName  String?
  status    ShiftStatus @default(BOOKED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, date])
  @@index([date, status])
}

/// Per-rider dispatch preferences + break mode. One row per rider.
model RiderPreferences {
  id             String    @id @default(cuid())
  riderId        String    @unique
  autoAccept     Boolean   @default(false)
  maxBatchSize   Int       @default(1)
  notifyRadiusKm Float     @default(5.0)
  preferredZones String[]  @default([])
  breakMode      Boolean   @default(false)
  breakUntil     DateTime?
  updatedAt      DateTime  @updatedAt

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

// ─── Bundle D · Growth & support ─────────────────────────────────────────────

enum RiderReferralStatus {
  PENDING
  SIGNED_UP
  QUALIFIED
  REWARDED
}

/// Refer-a-rider. The referrer shares their `code`; when the referee signs up
/// and completes qualifying deliveries the referrer earns `bonusAmount`.
model RiderReferral {
  id           String              @id @default(cuid())
  referrerId   String
  code         String              @unique
  refereePhone String?
  refereeName  String?
  status       RiderReferralStatus @default(PENDING)
  bonusAmount  Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt    DateTime            @default(now())
  qualifiedAt  DateTime?
  rewardedAt   DateTime?

  referrer RiderProfile @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
}

enum TrainingCategory {
  ONBOARDING
  SAFETY
  CUSTOMER_SERVICE
  EARNINGS
  APP_GUIDE
}

/// A bite-sized training/certification module. `contentBody` is markdown shown
/// in-app; `quizQuestions` is optional JSON for a short check.
model TrainingModule {
  id            String           @id @default(cuid())
  title         String
  summary       String?
  category      TrainingCategory @default(ONBOARDING)
  contentBody   String
  quizQuestions Json?
  durationMin   Int              @default(5)
  order         Int              @default(0)
  isRequired    Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())

  progress RiderTrainingProgress[]

  @@index([isActive, order])
}

model RiderTrainingProgress {
  id          String    @id @default(cuid())
  moduleId    String
  riderId     String
  completed   Boolean   @default(false)
  completedAt DateTime?
  quizScore   Int?
  updatedAt   DateTime  @updatedAt

  module TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  rider  RiderProfile   @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([moduleId, riderId])
  @@index([riderId])
}

enum RiderTicketCategory {
  PAYMENT
  APP_BUG
  ORDER_ISSUE
  KYC
  ACCOUNT
  SAFETY
  OTHER
}

enum RiderTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_RIDER
  RESOLVED
  CLOSED
}

/// An in-app support ticket raised by a rider, with a threaded message log.
/// Distinct from the customer-facing SupportTicket model.
model RiderSupportTicket {
  id        String              @id @default(cuid())
  riderId   String
  subject   String
  category  RiderTicketCategory @default(OTHER)
  status    RiderTicketStatus   @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  rider    RiderProfile          @relation(fields: [riderId], references: [id], onDelete: Cascade)
  messages RiderSupportMessage[]

  @@index([riderId, status])
  @@index([status, updatedAt])
}

model RiderSupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  fromRider  Boolean  @default(true)
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  ticket RiderSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Rider ⇄ staff direct messaging (2026-05-15)
//  A rider has at most one conversation thread with platform ops (SUPER_ADMIN)
//  and one per restaurant they're connected to (ADMIN). Bidirectional, real-time
//  via the existing SSE channel.
// ─────────────────────────────────────────────────────────────────────────────

enum RiderConversationParty {
  ADMIN // a restaurant admin (scoped to `restaurantId`)
  SUPER_ADMIN // platform operations
}

enum RiderMessageSender {
  RIDER
  ADMIN
  SUPER_ADMIN
}

model RiderConversation {
  id            String                 @id @default(cuid())
  riderId       String
  party         RiderConversationParty
  // Set only when `party = ADMIN` — the restaurant the admin belongs to.
  restaurantId  String?
  subject       String?
  lastMessageAt DateTime               @default(now())
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  rider    RiderProfile               @relation(fields: [riderId], references: [id], onDelete: Cascade)
  messages RiderConversationMessage[]

  @@index([riderId])
  @@index([party, restaurantId])
  @@index([lastMessageAt])
}

model RiderConversationMessage {
  id             String             @id @default(cuid())
  conversationId String
  sender         RiderMessageSender
  senderName     String?
  body           String
  readByRider    Boolean            @default(false)
  readByStaff    Boolean            @default(false)
  createdAt      DateTime           @default(now())

  conversation RiderConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

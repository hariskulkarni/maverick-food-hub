// ─────────────────────────────────────────────────────────────────────────────
//  Delivery
// ─────────────────────────────────────────────────────────────────────────────

// RiderProfile is now PLATFORM-managed. branchId is optional and represents
// a "home base" hint only (e.g. for matching nearby orders), not exclusivity.
/// How a rider is sourced. FLEET riders work the platform-wide shared pool;
/// DEDICATED riders belong to one restaurant and only see that restaurant's
/// orders (see Restaurant.riderDispatchMode for the per-restaurant policy).
enum RiderType {
  FLEET
  DEDICATED
}

model RiderProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  branchId              String? // optional home base, nullable now
  // Fleet vs. restaurant-dedicated. DEDICATED riders carry `dedicatedRestaurantId`.
  riderType             RiderType @default(FLEET)
  dedicatedRestaurantId String? // set when riderType = DEDICATED
  vehicleType           String    @default("BIKE")
  vehicleNumber         String?
  isOnline              Boolean   @default(false)
  currentLat            Float?
  currentLng            Float?
  expoPushToken         String? // Expo push token from the native rider app (FCM under the hood)
  currentLoad           Int       @default(0)
  rating                Float     @default(5.0)
  totalDeliveries       Int       @default(0)
  totalEarnings         Decimal   @default(0.00) @db.Decimal(12, 2)
  totalTips             Decimal   @default(0.00) @db.Decimal(12, 2)
  approvedById          String? // SUPER_ADMIN id who approved this rider
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch              Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  dedicatedRestaurant Restaurant?            @relation("DedicatedRiders", fields: [dedicatedRestaurantId], references: [id], onDelete: SetNull)
  assignments         RiderAssignment[]
  pings               DeliveryLocationPing[]
  codCollections      CodCollection[]
  kycDocuments        RiderKycDocument[]
  payoutOverrides     RiderPayoutOverride[]

  // Competitor-feature bundles (2026-05-14)
  payouts           RiderPayout[]
  incentiveProgress RiderIncentiveProgress[]
  emergencyContacts RiderEmergencyContact[]
  sosAlerts         SosAlert[]
  incidentReports   RiderIncidentReport[]
  tripShares        TripShare[]
  shifts            RiderShift[]
  preferences       RiderPreferences?
  referralsMade     RiderReferral[]
  trainingProgress  RiderTrainingProgress[]
  supportTickets    RiderSupportTicket[]
  conversations     RiderConversation[]
  batchInvitations  BatchInvitation[]

  @@index([isOnline])
  @@index([branchId, isOnline])
  @@index([riderType, isOnline])
  @@index([dedicatedRestaurantId, isOnline])
}

model RiderAssignment {
  id               String           @id @default(cuid())
  orderId          String           @unique
  riderId          String
  status           AssignmentStatus @default(PENDING)
  // claimedAt = rider picked from pool (replaces assignedAt for pool model)
  claimedAt        DateTime?
  assignedAt       DateTime         @default(now())
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  // Earnings breakdown set by super-admin DeliveryPayoutRule + customer tip
  baseEarningsAmt  Decimal          @default(0.00) @db.Decimal(10, 2)
  bonusAmt         Decimal          @default(0.00) @db.Decimal(10, 2) // peak/rain/incentive
  tipAmt           Decimal          @default(0.00) @db.Decimal(10, 2) // from customer
  earningsAmt      Decimal          @default(0.00) @db.Decimal(10, 2) // total to rider = base + bonus + tip
  // Proof of delivery
  deliveryPhotoUrl String?
  deliveryNote     String?
  // Rating from customer (1-5)
  customerRating   Int?
  customerComment  String?
  notes            String?

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Restrict)

  @@index([riderId, status])
  @@index([status, claimedAt])
}

model DeliveryLocationPing {
  id        String   @id @default(cuid())
  riderId   String
  orderId   String?
  lat       Float
  lng       Float
  speedKph  Float?
  createdAt DateTime @default(now())

  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId, createdAt])
  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  BatchInvitation — offer to append a new drop to a rider already mid-delivery
// ─────────────────────────────────────────────────────────────────────────────
// When the live pool has more READY orders than free riders, the dispatcher
// looks at OUT_FOR_DELIVERY riders whose customer-drop is close to the new
// pickup. Each candidate gets a BatchInvitation row with a 15-second TTL and
// a push + SSE event. The rider's app shows a full-screen accept/decline
// countdown; on ACCEPTED the new order is added to their assignment queue and
// the matching invitations on other riders for the same order are
// auto-cancelled.
enum BatchInvitationStatus {
  PENDING // active, waiting on rider
  ACCEPTED // rider tapped Accept — order is now in their queue
  DECLINED // rider tapped Decline
  EXPIRED // 15s timer ran out without action
  CANCELLED // another rider accepted first, or admin pulled the order
}

model BatchInvitation {
  id            String                @id @default(cuid())
  orderId       String // the NEW order being offered
  riderId       String // the rider already on a delivery
  status        BatchInvitationStatus @default(PENDING)
  // Routing economics shown to the rider so they can decide:
  detourKm      Float // extra distance vs. straight customer drop
  extraEarnings Decimal               @default(0.00) @db.Decimal(10, 2)
  pickupEtaMin  Int? // mins to the pickup from rider's current location
  invitedAt     DateTime              @default(now())
  expiresAt     DateTime // invitedAt + 15s by default
  respondedAt   DateTime? // when ACCEPTED / DECLINED / EXPIRED stamped
  reason        String? // free-text decline reason or cancel cause

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)

  // A rider should see only one PENDING row per order; uniqueness on
  // (orderId, riderId) keeps re-fan-out from creating duplicates.
  @@unique([orderId, riderId])
  @@index([riderId, status])
  @@index([orderId, status])
  @@index([status, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Engagement: Loyalty, Wallet, Referrals
// ─────────────────────────────────────────────────────────────────────────────

model LoyaltyAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  pointsBalance  Int      @default(0)
  lifetimeEarn   Int      @default(0)
  lifetimeRedeem Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String         @id @default(cuid())
  accountId String
  orderId   String?
  type      LoyaltyTxnType
  points    Int
  note      String?
  createdAt DateTime       @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id])

  @@index([accountId, createdAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0.00) @db.Decimal(10, 2)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  txns WalletTransaction[]
}

model WalletTransaction {
  id        String        @id @default(cuid())
  walletId  String
  orderId   String?
  type      WalletTxnType
  amount    Decimal       @db.Decimal(10, 2)
  note      String?
  createdAt DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([walletId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Signup bonus — staggered redemption credit for new customers
// ─────────────────────────────────────────────────────────────────────────────
// Super Admin defines a single global rule (the `SignupBonusConfig` singleton)
// like "₹100 bonus, split across 5 delivered orders". Each new customer gets a
// `SignupBonusGrant` at sign-up with `totalAmount` and `remainingOrders` set
// from the config. On checkout we auto-apply min(perOrderCap, remainingAmount)
// as a discount, but only *commit* the consumption once the order transitions
// to DELIVERED. Cancellations or refunds restore the consumed amount + order
// counter, so a customer who tries-and-cancels can still use their full bonus.
//
// Abuse prevention: we snapshot phone, IP, and (optional) device fingerprint
// at grant time. The grant API refuses to issue when any of those already
// have an active grant against them. Only delivered orders move the counter.

model SignupBonusConfig {
  id                 String   @id @default("singleton") // forces a single row
  isActive           Boolean  @default(false)
  totalAmount        Decimal  @default(100.00) @db.Decimal(10, 2)
  splitCount         Int      @default(5) // total bonus / splitCount = per-order cap
  // Per-order ceiling expressed directly so admins can decouple ratio when
  // they want (e.g. ₹100 grant but only ₹15 per order, expires after 5 orders).
  perOrderCap        Decimal? @db.Decimal(10, 2)
  minOrderValue      Decimal? @db.Decimal(10, 2) // minimum cart subtotal to be eligible
  // Abuse-prevention toggles
  phoneCheckEnabled  Boolean  @default(true)
  ipCheckEnabled     Boolean  @default(true)
  deviceCheckEnabled Boolean  @default(false)
  // Optional expiry — grants older than this are no longer usable.
  validityDays       Int      @default(90)
  updatedById        String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

// One row per customer. `usedAmount` only increments when an order moves to
// DELIVERED; `pendingAmount` tracks "this amount is locked because the order
// is in flight". `remainingOrders` decrements at DELIVERED and re-increments
// at CANCELLED/REFUNDED.
model SignupBonusGrant {
  id              String    @id @default(cuid())
  userId          String    @unique
  totalAmount     Decimal   @db.Decimal(10, 2)
  perOrderCap     Decimal   @db.Decimal(10, 2)
  // Used + pending are kept separate so the UI can distinguish "credited" vs
  // "tentatively allocated to an in-flight order".
  usedAmount      Decimal   @default(0) @db.Decimal(10, 2)
  pendingAmount   Decimal   @default(0) @db.Decimal(10, 2)
  remainingOrders Int // starts at SignupBonusConfig.splitCount
  // Abuse snapshots — null on legacy data; never reused for matching after grant.
  phoneSnapshot   String?
  ipSnapshot      String?
  deviceSnapshot  String?
  // Lifecycle
  expiresAt       DateTime?
  // Revocations (e.g. admin invalidates due to abuse) are soft.
  revokedAt       DateTime?
  revokedReason   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger SignupBonusLedger[]

  @@index([phoneSnapshot])
  @@index([ipSnapshot])
}

// Append-only event log of every bonus interaction so the customer-facing
// "X of ₹100 used" math is auditable and the order machine's restore-on-cancel
// path doesn't lose precision. `delta` is positive on consumption, negative
// on restoration.
model SignupBonusLedger {
  id        String   @id @default(cuid())
  grantId   String
  orderId   String?
  // 'APPLY' (pending hold at checkout), 'COMMIT' (delivered), 'RESTORE' (cancel/refund),
  // 'EXPIRE' (validity passed), 'REVOKE' (admin action), 'GRANT' (initial issuance).
  kind      String
  delta     Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  grant SignupBonusGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  order Order?           @relation(fields: [orderId], references: [id])

  @@index([grantId, createdAt])
  @@index([orderId])
}

model Referral {
  id                String    @id @default(cuid())
  referrerId        String
  referredId        String? // null until claimed
  code              String    @unique
  rewardForReferrer Decimal   @default(100.00) @db.Decimal(10, 2)
  rewardForReferred Decimal   @default(50.00) @db.Decimal(10, 2)
  fulfilledAt       DateTime?
  createdAt         DateTime  @default(now())

  referrer User  @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("Referred", fields: [referredId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
//  Inventory (future feature)

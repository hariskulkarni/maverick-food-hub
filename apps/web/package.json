{
  "name": "restaurant-manager-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:cuisines": "tsx prisma/seed-brand-mavericks.ts",
    "db:seed:rider-features": "tsx prisma/seed-rider-features.ts",
    "db:enable-order-flow": "tsx prisma/enable-order-flow.ts",
    "db:set-packaging-fee": "tsx prisma/set-packaging-fee.ts",
    "db:group-restaurants": "tsx prisma/group-restaurants.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "pretest": "prisma generate",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=dot",
    "pretest:ci": "prisma generate",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run test:ci"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "nanoid": "^5.0.8",
    "next": "^15.5.18",
    "next-auth": "^5.0.0-beta.25",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "sharp": "^0.33.5",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "nodemailer": "^8.0.7",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "nodemailer": "^8.0.7",
    "postcss": "^8.5.10"
  }
}

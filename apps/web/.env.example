# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant?schema=public
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
# Local dev uses localhost. In PRODUCTION set this to the live origin, e.g.
#   NEXTAUTH_URL=https://flavrly.in
# IMPORTANT: only switch to the https:// flavrly.in value AFTER TLS is live on the
# VPS — setting https here also turns on HSTS + upgrade-insecure-requests, which
# breaks every asset if the site is still served over plain HTTP.
NEXTAUTH_URL=http://localhost:3000

# Encryption key for integration secrets at rest (AES-256-GCM).
# REQUIRED IN PRODUCTION — the app hard-fails if it's missing when NODE_ENV=production
# (it will NOT fall back to NEXTAUTH_SECRET in prod). Must decode to exactly 32 bytes.
# Generate with:  openssl rand -base64 32
# In local dev you may leave this blank (a key is derived from NEXTAUTH_SECRET).
INTEGRATION_ENCRYPTION_KEY=

# ============================================================================
# PRODUCTION SECURITY CHECKLIST (set these before launching to REAL users):
#   INTEGRATION_ENCRYPTION_KEY  = a real 32-byte base64 key (see above)
#   NOTIFIER_SMS                = a real provider (2factor/msg91/...) + its creds
#   OTP_DEMO_MODE / OTP_DEBUG_LOG = false   (must be off once real SMS is on —
#                                  enabling demo + a real provider HARD-FAILS boot)
#   ALLOW_CUSTOMER_SELF_SIGNUP  = false   unless open customer signup is intended
#   NEXTAUTH_SECRET             = a unique 32-byte secret, never the example value
#   RAZORPAY_WEBHOOK_SECRET     = set, so payment webhooks verify signatures
#   PHONEPE_WEBHOOK_USERNAME    = set (with _PASSWORD), so PhonePe webhooks authenticate
#   PHONEPE_WEBHOOK_PASSWORD    = set, and matching the PhonePe dashboard config
#   PHONEPE_ENV                 = PRODUCTION (never leave SANDBOX in prod)
#   NEXT_PUBLIC_SITE_URL       = your real https domain — PhonePe rejects
#                                 non-HTTPS return URLs and blocks payments whose
#                                 host is not the one whitelisted on your account
#                                 (INTERNAL_SECURITY_BLOCK_1)
#   INTERNAL_CRON_SECRET        = set, so the payment reconciliation sweep can run
#
# DEMO BEFORE YOU BUY SMS:  it's fine to run in production with NOTIFIER_SMS=mock
# and OTP_DEMO_MODE=true — login codes are shown on screen / in logs (NO real
# users yet). PLUG-AND-PLAY to real SMS later: set NOTIFIER_SMS=<provider> + its
# API key, and set OTP_DEMO_MODE=false (remove OTP_DEBUG_LOG). No code change.
# ============================================================================

# --- Redis cache (optional in dev; STRONGLY recommended in production) ---
# When REDIS_URL is set, the app uses Redis for: (1) the OTP / API rate-limit
# store (survives deploys + works across pm2 workers), (2) read-through caching
# for restaurant lookups, storefront config, discovery config, platform
# security and integration credentials, (3) the realtime SSE bus's cross-
# instance bridge, and (4) distributed locks / idempotency keys.
#
# When REDIS_URL is empty, the app boots with an in-process memory backend.
# Everything still works on a single process — just no cross-instance fan-out
# and counters reset on deploy. Use this for local dev.
#
# Format:  redis://[:password@]host:port[/db]
# Self-hosted on Hostinger:  redis://127.0.0.1:6379
# Upstash:                   rediss://default:<token>@<endpoint>:<port>
REDIS_URL=
# Versioned namespace prefix. Bump the vN suffix to mass-invalidate the cache
# after a schema/payload change without flushing the database.
REDIS_KEY_PREFIX=flavrly:v1:

# --- Optional adapters: leave on "mock" for local dev ---
# PAYMENT_PROVIDER is only the PLATFORM-WIDE fallback. Each restaurant normally
# stores its own gateway credentials in Storefront CMS -> Integrations, which
# always take precedence over everything below.
#   mock      auto-confirms after a moment (local dev, no gateway account needed)
#   razorpay  uses RAZORPAY_* below
#   phonepe   uses PHONEPE_* below
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- PhonePe Payment Gateway (Standard Checkout V2) ---
# V2 = OAuth credentials from PhonePe Business Dashboard -> Developer Settings.
# The legacy V1 pair (Merchant ID + Salt Key + Salt Index) is deprecated and
# will fail with 404 / Key_not_configured against these endpoints.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# SANDBOX -> https://api-preprod.phonepe.com/apis/pg-sandbox
# PRODUCTION -> https://api.phonepe.com/apis/{identity-manager,pg}
PHONEPE_ENV=SANDBOX
# Webhook auth pair. Invent any username/password, register them on the PhonePe
# dashboard (auth type: SHA) against
#   https://<your-domain>/api/payments/phonepe/webhook
# subscribed to: checkout.order.completed, checkout.order.failed,
#                pg.refund.accepted, pg.refund.completed, pg.refund.failed
# PhonePe then sends Authorization: SHA256(username:password) on each delivery.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- SMS / WhatsApp / Email delivery (OTP login codes, order notifications) ---
# NOTIFIER_SMS picks the SMS provider. Options: mock | 2factor | msg91 | fast2sms | textlocal | twilio
#   - "mock"     → no real SMS; codes are journaled to NotificationLog (free, demo/dev).
#   - "2factor"  → cheapest India OTP gateway (~₹0.16/SMS, no monthly fee). RECOMMENDED.
#   - "msg91"    → ₹0.25/SMS, bundles free email + WhatsApp under one vendor.
#   - "fast2sms" → ₹0.25/SMS.
# DEMO MODE: with NOTIFIER_SMS=mock, set OTP_DEMO_MODE=true (or the legacy alias
# OTP_DEBUG_LOG=true) to surface the OTP on the login screen + logs so you can
# demo without an SMS gateway. This is allowed in production AS LONG AS the SMS
# provider is still "mock" (no real users to leak).
# SAFETY: enabling demo mode while a REAL provider is configured (NOTIFIER_SMS
# != mock) HARD-FAILS at boot — that combination would leak real users' codes.
# Going live with real SMS = set NOTIFIER_SMS=<provider> + creds, OTP_DEMO_MODE=false.
NOTIFIER_SMS=mock
OTP_DEMO_MODE=true
NOTIFIER_WHATSAPP=mock
NOTIFIER_EMAIL=mock

# --- 2Factor.in (recommended India OTP gateway — cheapest at ~₹0.16/SMS) ---
# Sign up at https://2factor.in → get your API key from the dashboard.
# India DLT: register an OTP template (2Factor helps with onboarding), then put
# its name in TWOFACTOR_TEMPLATE_NAME. To enable: set NOTIFIER_SMS=2factor above.
TWOFACTOR_API_KEY=
TWOFACTOR_SENDER_ID=
TWOFACTOR_TEMPLATE_NAME=

# --- Fast2SMS (recommended India SMS gateway for OTP) ---
# Sign up at https://www.fast2sms.com → Dashboard → Dev API → copy the API key.
# To enable: set NOTIFIER_SMS=fast2sms above, then fill FAST2SMS_API_KEY.
#   route "q"   = quick/promotional — works without DLT registration (fine to start).
#   route "dlt" = transactional — required by TRAI for production OTP at scale;
#                 needs a DLT-approved sender ID + message template ID.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# --- MSG91 (alternative India SMS gateway) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=
MSG91_DLT_TEMPLATE_ID=

# --- TextLocal (alternative India SMS gateway) ---
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Restaurant <noreply@example.com>

GOOGLE_MAPS_API_KEY=

# --- Google OAuth (customer sign-in) ---
# Leave both blank to disable the "Continue with Google" button on tenant login pages.
# Get credentials at https://console.cloud.google.com/apis/credentials — set the
# authorized redirect URI to <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login hardening. Default (unset/"true") lets unknown customers self-register
# via phone-OTP or Google on first login. Set to "false" to lock the platform
# down so ONLY pre-registered/invited accounts can log in anywhere — unknown
# phones/emails are rejected (and the attempt is audit-logged). Staff
# (email+password) and riders always require a pre-existing account regardless.
ALLOW_CUSTOMER_SELF_SIGNUP=true

STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Platform brand ---
# NEXT_PUBLIC_BRAND_NAME overrides the platform name at deploy time (e.g. a white-label rebrand).
# Leave the defaults below for "Maverick's Food Hub".
NEXT_PUBLIC_BRAND_NAME=Flavrly
NEXT_PUBLIC_BRAND_TAGLINE=Every flavour in town — delivered.
NEXT_PUBLIC_SUPPORT_PHONE=+919999999999
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919999999999
NEXT_PUBLIC_CURRENCY=INR

# ── Domain split (customer site vs staff portal) ──────────────────────────────
# One deployment serves both hosts; the app routes by Host header. Defaults are
# the production domains, so you normally don't need to set these.
PUBLIC_HOST=flavrly.in
PORTAL_HOST=portal.flavrly.in
# Absolute URL of the staff portal, for any cross-host links shown on the
# customer site (optional).
NEXT_PUBLIC_PORTAL_URL=https://portal.flavrly.in

# ── Break-glass staff accounts ────────────────────────────────────────────────
# Comma-separated emails that bypass Google Authenticator (2FA) + IP allowlist
# and sign in with email + password only. Emergency access — keep this list tiny
# and the passwords strong. Every break-glass login is audited.
BREAKGLASS_EMAILS=

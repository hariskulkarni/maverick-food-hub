# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant?schema=public
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Encryption key for integration secrets at rest (AES-256-GCM).
# REQUIRED IN PRODUCTION — the app hard-fails if it's missing when NODE_ENV=production
# (it will NOT fall back to NEXTAUTH_SECRET in prod). Must decode to exactly 32 bytes.
# Generate with:  openssl rand -base64 32
# In local dev you may leave this blank (a key is derived from NEXTAUTH_SECRET).
INTEGRATION_ENCRYPTION_KEY=

# ============================================================================
# PRODUCTION SECURITY CHECKLIST (set these before going live):
#   INTEGRATION_ENCRYPTION_KEY  = a real 32-byte base64 key (see above)
#   OTP_DEBUG_LOG               = false   (true is REJECTED in production)
#   ALLOW_CUSTOMER_SELF_SIGNUP  = false   unless open customer signup is intended
#   NEXTAUTH_SECRET             = a unique 32-byte secret, never the example value
#   RAZORPAY_WEBHOOK_SECRET     = set, so payment webhooks verify signatures
# ============================================================================

# --- Optional adapters: leave on "mock" for local dev ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS / WhatsApp / Email delivery (OTP login codes, order notifications) ---
# NOTIFIER_SMS picks the SMS provider. Options: mock | 2factor | msg91 | fast2sms | textlocal | twilio
#   - "mock"     → no real SMS; codes are journaled to NotificationLog (free, demo/dev).
#   - "2factor"  → cheapest India OTP gateway (~₹0.16/SMS, no monthly fee). RECOMMENDED.
#   - "msg91"    → ₹0.25/SMS, bundles free email + WhatsApp under one vendor.
#   - "fast2sms" → ₹0.25/SMS.
# When NOTIFIER_SMS=mock, set OTP_DEBUG_LOG=true to surface the OTP in logs +
# the rider app's verify screen (what the demo uses).
# PRODUCTION: OTP_DEBUG_LOG MUST be false (or unset). The app throws on startup
# if NODE_ENV=production and OTP_DEBUG_LOG=true, because leaking OTP codes in
# logs/responses is an account-takeover vector.
NOTIFIER_SMS=mock
OTP_DEBUG_LOG=true
NOTIFIER_WHATSAPP=mock
NOTIFIER_EMAIL=mock

# --- 2Factor.in (recommended India OTP gateway — cheapest at ~₹0.16/SMS) ---
# Sign up at https://2factor.in → get your API key from the dashboard.
# India DLT: register an OTP template (2Factor helps with onboarding), then put
# its name in TWOFACTOR_TEMPLATE_NAME. To enable: set NOTIFIER_SMS=2factor above.
TWOFACTOR_API_KEY=
TWOFACTOR_SENDER_ID=
TWOFACTOR_TEMPLATE_NAME=

# --- Fast2SMS (recommended India SMS gateway for OTP) ---
# Sign up at https://www.fast2sms.com → Dashboard → Dev API → copy the API key.
# To enable: set NOTIFIER_SMS=fast2sms above, then fill FAST2SMS_API_KEY.
#   route "q"   = quick/promotional — works without DLT registration (fine to start).
#   route "dlt" = transactional — required by TRAI for production OTP at scale;
#                 needs a DLT-approved sender ID + message template ID.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# --- MSG91 (alternative India SMS gateway) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=
MSG91_DLT_TEMPLATE_ID=

# --- TextLocal (alternative India SMS gateway) ---
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Restaurant <noreply@example.com>

GOOGLE_MAPS_API_KEY=

# --- Google OAuth (customer sign-in) ---
# Leave both blank to disable the "Continue with Google" button on tenant login pages.
# Get credentials at https://console.cloud.google.com/apis/credentials — set the
# authorized redirect URI to <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login hardening. Default (unset/"true") lets unknown customers self-register
# via phone-OTP or Google on first login. Set to "false" to lock the platform
# down so ONLY pre-registered/invited accounts can log in anywhere — unknown
# phones/emails are rejected (and the attempt is audit-logged). Staff
# (email+password) and riders always require a pre-existing account regardless.
ALLOW_CUSTOMER_SELF_SIGNUP=true

STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Platform brand ---
# NEXT_PUBLIC_BRAND_NAME overrides the platform name at deploy time (e.g. a white-label rebrand).
# Leave the defaults below for "Maverick's Food Hub".
NEXT_PUBLIC_BRAND_NAME=Maverick's Food Hub
NEXT_PUBLIC_BRAND_TAGLINE=Every kitchen in town, in one place. Order in three taps.
NEXT_PUBLIC_SUPPORT_PHONE=+919999999999
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919999999999
NEXT_PUBLIC_CURRENCY=INR

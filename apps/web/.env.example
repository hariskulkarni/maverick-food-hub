# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant?schema=public
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# --- Optional adapters: leave on "mock" for local dev ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS / WhatsApp / Email delivery (OTP login codes, order notifications) ---
# NOTIFIER_SMS picks the SMS provider. Options: mock | fast2sms | msg91 | textlocal | twilio
#   - "mock"     → no real SMS; codes are journaled to NotificationLog (free, demo/dev).
#   - "fast2sms" → cheapest India option (~₹0.15/SMS, free starter credits).
# When NOTIFIER_SMS=mock, set OTP_DEBUG_LOG=true to surface the OTP in logs +
# the rider app's verify screen (what the demo uses).
NOTIFIER_SMS=mock
OTP_DEBUG_LOG=true
NOTIFIER_WHATSAPP=mock
NOTIFIER_EMAIL=mock

# --- Fast2SMS (recommended India SMS gateway for OTP) ---
# Sign up at https://www.fast2sms.com → Dashboard → Dev API → copy the API key.
# To enable: set NOTIFIER_SMS=fast2sms above, then fill FAST2SMS_API_KEY.
#   route "q"   = quick/promotional — works without DLT registration (fine to start).
#   route "dlt" = transactional — required by TRAI for production OTP at scale;
#                 needs a DLT-approved sender ID + message template ID.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# --- MSG91 (alternative India SMS gateway) ---
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=
MSG91_DLT_TEMPLATE_ID=

# --- TextLocal (alternative India SMS gateway) ---
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Restaurant <noreply@example.com>

GOOGLE_MAPS_API_KEY=

# --- Google OAuth (customer sign-in) ---
# Leave both blank to disable the "Continue with Google" button on tenant login pages.
# Get credentials at https://console.cloud.google.com/apis/credentials — set the
# authorized redirect URI to <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Platform brand ---
# NEXT_PUBLIC_BRAND_NAME overrides the platform name at deploy time (e.g. a white-label rebrand).
# Leave the defaults below for "Maverick's Food Hub".
NEXT_PUBLIC_BRAND_NAME=Maverick's Food Hub
NEXT_PUBLIC_BRAND_TAGLINE=Every kitchen in town, in one place. Order in three taps.
NEXT_PUBLIC_SUPPORT_PHONE=+919999999999
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919999999999
NEXT_PUBLIC_CURRENCY=INR

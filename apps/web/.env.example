# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant?schema=public
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# --- Optional adapters: leave on "mock" for local dev ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

NOTIFIER_SMS=mock
NOTIFIER_WHATSAPP=mock
NOTIFIER_EMAIL=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Restaurant <noreply@example.com>

GOOGLE_MAPS_API_KEY=

# --- Google OAuth (customer sign-in) ---
# Leave both blank to disable the "Continue with Google" button on tenant login pages.
# Get credentials at https://console.cloud.google.com/apis/credentials — set the
# authorized redirect URI to <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Platform brand ---
# NEXT_PUBLIC_BRAND_NAME overrides the platform name at deploy time (e.g. a white-label rebrand).
# Leave the defaults below for "Maverick's Food Hub".
NEXT_PUBLIC_BRAND_NAME=Maverick's Food Hub
NEXT_PUBLIC_BRAND_TAGLINE=Every kitchen in town, in one place. Order in three taps.
NEXT_PUBLIC_SUPPORT_PHONE=+919999999999
NEXT_PUBLIC_SUPPORT_WHATSAPP=+919999999999
NEXT_PUBLIC_CURRENCY=INR

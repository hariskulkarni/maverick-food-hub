# ════════════════════════════════════════════════════════════════════════
#   .env.demo — env file for the DEMO runtime (demo.flavrly.in)
#
#   Copy this to .env.demo on the VPS and fill in the values. The demo pm2
#   process loads this file (see ecosystem.config.js).
#
#   PROD's .env is UNCHANGED. The demo runtime reads only THIS file.
# ════════════════════════════════════════════════════════════════════════

# ── Master flag ─────────────────────────────────────────────────────────
DEMO_MODE=true
NODE_ENV=production
PORT=3001

# ── URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://demo.flavrly.in
NEXTAUTH_URL=https://demo.flavrly.in

# ── Auth ────────────────────────────────────────────────────────────────
# Use a DIFFERENT secret to prod so cookies / JWTs don't cross-contaminate.
# Generate one: `openssl rand -base64 32`
NEXTAUTH_SECRET=CHANGE_ME_DIFFERENT_FROM_PROD
# Same secret as NEXTAUTH_SECRET works fine for signing gate cookies; or set
# a separate one for slightly tighter isolation.
DEMO_GATE_SECRET=CHANGE_ME_OR_LEAVE_BLANK_TO_REUSE_NEXTAUTH_SECRET

# ── Demo gate password ─────────────────────────────────────────────────
# Single shared password that unlocks the demo site for 24h. Pick something
# memorable enough to share on a call, but not trivial. e.g.:
#   openssl rand -base64 12   →  use the first ~10 chars
DEMO_GATE_PASSWORD=CHANGE_ME_SET_A_STRONG_DEMO_PASSWORD

# ── Demo Postgres database (separate from prod) ────────────────────────
# Create it first:  sudo -u postgres psql -c "CREATE DATABASE flavrly_demo;"
DATABASE_URL=postgresql://flavrly_demo_user:CHANGE_ME@127.0.0.1:5432/flavrly_demo?schema=public

# ── Integration safety: ALL of these MUST be sandboxed in demo ─────────
# Razorpay → mock provider (auto-success after 1s, never hits Razorpay).
PAYMENT_PROVIDER=mock
# SMS → mock notifier (no SMS sent, logged only).
NOTIFIER_SMS=mock
# Disable real WhatsApp / push providers.
NOTIFIER_WHATSAPP=
# OTP → demo mode (always accepts 123456).
OTP_DEMO_MODE=true

# ── Encryption (required by prod parity — generate a NEW key) ──────────
# openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_FROM_PROD

# ── Email (OPTIONAL on demo) ───────────────────────────────────────────
# The demo gate no longer sends email — it's a single shared password. You
# only need SMTP here if you want the platform's alert engine, signup
# emails, etc. to actually fire on demo. Leave blank to silently no-op.
# NOTIFIER_EMAIL=zoho_smtp
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=demo@flavrly.in
# SMTP_SECURE=true

# ── Discovery / misc — same as prod ────────────────────────────────────
# Anything not set here falls back to safe defaults at runtime.

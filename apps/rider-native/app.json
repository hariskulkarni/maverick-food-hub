{
  "expo": {
    "name": "Flavrly",
    "slug": "rider-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flavrlyrider",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flavrly.rider",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps"
        ],
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.flavrly.rider",
      "adaptiveIcon": {
        "backgroundColor": "#f23e5c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fff7f8",
          "dark": {
            "backgroundColor": "#1a0f16"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flavrly Rider uses your location to share live delivery tracking with customers and to offer you nearby orders while you're online.",
          "locationAlwaysAndWhenInUsePermission": "During an active delivery, Flavrly Rider keeps sharing your location in the background (even while you use Google Maps or your phone is locked) so customers can track their order live and for your safety. It stops when the delivery ends, you go offline or sign out.",
          "locationAlwaysPermission": "During an active delivery, Flavrly Rider keeps sharing your location in the background so customers can track their order live and for your safety. It stops when the delivery ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Flavrly Rider uses the camera to capture proof-of-delivery photos at hand-over."
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "368d4289-e61b-4a59-8b02-8dc65783faad"
      }
    },
    "owner": "maverick_here"
  }
}
